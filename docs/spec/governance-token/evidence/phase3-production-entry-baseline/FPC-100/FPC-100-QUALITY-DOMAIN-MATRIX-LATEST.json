      "examples": ["data_leak", "auth_bypass", "fund_safety", "core_flow_blocked", "severe_production_crash"],
      "release_rule": "OPEN_P0 = 0"
    },
    "P1": {
      "label_zh": "通常必须修复 · 阻断发布",
      "examples": ["major_feature_broken", "large_user_impact", "core_experience_severely_degraded"],
      "release_rule": "OPEN_P1 = 0"
    },
    "P2": {
      "label_zh": "可评估 · 不默认阻断",
      "examples": ["minor_ui", "copy", "non_critical_ux"],
      "release_rule": "FIX or register ACCEPTED_RISK with Owner sign-off"
    },
    "P3": {
      "label_zh": "Enhancement · 不阻断发布",
      "examples": ["feature_suggestion", "ux_optimization"],
      "release_rule": "backlog_only"
    }
  },
