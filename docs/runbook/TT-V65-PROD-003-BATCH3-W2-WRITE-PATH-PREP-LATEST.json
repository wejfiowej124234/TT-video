  "idempotency_key_lifecycle": {
    "headers": [
      "Idempotency-Key",
      "X-Idempotency-Key"
    ],
    "helper": "frontend/lib/apiClient/core.ts#writeRequestHeaders(idempotencyKey?)",
    "server_cache_key": "method + path + Idempotency-Key",
    "server_ssot": "crates/api/src/middleware/mod.rs",
    "phases": [
      {
        "name": "MINT",
        "when": "User intent starts (form submit / mutation session / workflow action click)",
        "rule": "One UUID (or stable mutation id) per user intent — NOT per HTTP attempt"
      },
      {
        "name": "ATTACH",
        "when": "Building request headers",
        "rule": "writeRequestHeaders(stableKey); forbid bare writeRequestHeaders() on critical CMS/admin writes in W2 scope"
      },
      {
        "name": "REUSE",
        "when": "Network retry · double-click · transport timeout before terminal success",
        "rule": "Same key until 2xx success response accepted by client OR explicit replay/409 treated as success"
      },
      {
        "name": "ROTATE",
        "when": "Terminal success · user cancel · new distinct intent · validation 4xx after payload correction",
        "rule": "Mint new key only for a new intent; do not rotate on blind retry"
      },
      {
        "name": "SERVER_REPLAY",
        "when": "Duplicate method+path+key hits cache",
        "rule": "Return prior response / no second side-effect; observable in audit as replay not double-write"
      },
      {
        "name": "FAIL_CLOSED",
        "when": "Path in is_admin_critical_write_path (after R061 expansion) missing key",
        "rule": "400 with required_header Idempotency-Key — no silent proceed"
      }
    ],
    "locale_honesty": {
      "bad_copy_example": "admin_approvals_idempotency_hint currently implies each submit mints a new key",
      "target": "Hint must say retry reuses the same key; only a new user intent mints a new key"
    }
  },
