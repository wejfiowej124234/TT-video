# tt-web-staging · Docker build-time NEXT_PUBLIC_*（复制为 build.env.local · 勿提交）
#
#   cp deploy/fly/tt-web-staging/build.env.example deploy/fly/tt-web-staging/build.env.local
#   bash scripts/dev/deploy-tt-web-staging.sh
#
# 地址须与 tt-api-staging GET /meta 及 scripts/dev/.env.staging-onboarding.local 对拍

NEXT_PUBLIC_API_BASE_URL=https://tt-api-staging.fly.dev
NEXT_PUBLIC_SITE_URL=https://tt-web-staging.fly.dev
API_REWRITE_TARGET=https://tt-api-staging.fly.dev
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.drpc.org

# Sepolia ACTIVE = v311_sepolia_clean_baseline（registry/protocol-convergence-deployments）
# Escrow/FeeRouter/Registry/Guide/Provider 仍用 fund-stack composite（Money-Path 另窗 · 本窗不改）
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=0xbf746B6a330e61416c6D87aB9b0758f7107C8006
NEXT_PUBLIC_FEE_ROUTER_ADDRESS=0x81A8009210c5215100564c6E4123F672c4459306
NEXT_PUBLIC_GOVERNOR_ADDRESS=0x1ce4fbe80557bc2111a814f60a2334de41032116
NEXT_PUBLIC_GOVERNANCE_TOKEN_ADDRESS=0x5d2edabf062e1d8accda2bd35c0d9b26cfcd5ec0
NEXT_PUBLIC_TIMELOCK_ADDRESS=0x462402082b395f218ffb3634ec0611e39bdd504c
NEXT_PUBLIC_REGISTRY_ADDRESS=0xc50913e154f850583D0afbE9158a75E0e2167AAb
NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=0x5bdACF35292bDd681103BBb50865d8D2Fd49653f
NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=0xa90cA23767C1DdcA1Eb8AB292185e9af1106b075
NEXT_PUBLIC_REGION_STEWARD_STAKE_POOL_ADDRESS=0xc229d58987e0755467eb4ee53572f7139baf7281

# C-S6 · Catalog Consumer opt-in（Staging only · 生产 NEXT_PUBLIC_CATALOG_API_ENABLED 仍为 0）
NEXT_PUBLIC_CATALOG_API_ENABLED=1

# MED-04 · Community media public base（COS permanent · staging_primary = fly_tigris）
# Must match API COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL; remotePatterns SSOT = frontend/next.config.js
NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=https://traveltrust-community-media.fly.storage.tigris.dev
NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=https://traveltrust-community-media.fly.storage.tigris.dev

# OA-01 · WalletConnect v2 Project ID（32-hex · 勿提交真实值到 git）
