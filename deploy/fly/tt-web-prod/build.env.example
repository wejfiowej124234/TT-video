# tt-web-prod · Docker build-time NEXT_PUBLIC_*（复制为 build.env.local · 勿提交）
#
#   cp deploy/fly/tt-web-prod/build.env.example deploy/fly/tt-web-prod/build.env.local
#   # 填实下方 PROD 域名与 API base
#   bash scripts/dev/deploy-tt-web-production.sh
#
# 地址须与 tt-api-prod GET /meta 及 scripts/dev/.env.production.local 对拍

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
API_REWRITE_TARGET=https://api.example.com
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_RPC_URL=https://sepolia.drpc.org

# 与 phase3-production-fly-deploy-and-sync.sh secrets 同源（按 scope 换主网地址）
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=
NEXT_PUBLIC_FEE_ROUTER_ADDRESS=
NEXT_PUBLIC_GOVERNOR_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=
NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=
