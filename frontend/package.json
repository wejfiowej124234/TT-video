{
  "name": "traveltrust-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node ./scripts/clean-next.mjs",
    "doctor:3012": "node ./scripts/doctor-ui-3012.mjs",
    "dev": "node ./scripts/run-dev.mjs",
    "dev:turbopack": "node ./scripts/ensure-turbo-dev.mjs && node ./node_modules/next/dist/bin/next dev --turbopack -p 3012",
    "dev:webpack": "node ./scripts/ensure-dev-next.mjs && node ./node_modules/next/dist/bin/next dev -p 3012",
    "dev:clean": "npm run clean && node ./scripts/run-dev.mjs",
    "dev:force": "node ./scripts/ensure-turbo-dev.mjs --force && node ./scripts/run-dev.mjs",
    "dev:warm": "node ./scripts/warm-dev-routes.mjs http://127.0.0.1:3012",
    "dev:3000": "node ./scripts/ensure-turbo-dev.mjs && node ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:3000:clean": "npm run clean && node ./scripts/ensure-turbo-dev.mjs && node ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "node ./node_modules/next/dist/bin/next build && node ./scripts/sync-server-chunks.mjs",
    "build:clean": "npm run clean && node ./node_modules/next/dist/bin/next build && node ./scripts/sync-server-chunks.mjs",
    "start": "node ./scripts/ensure-next-start.mjs && node ./node_modules/next/dist/bin/next start -p 3012",
    "lint": "next lint",
    "test": "vitest run",
    "test:i18n:ci": "node scripts/check-i18n-coverage.mjs",
    "test:regional:ci": "node scripts/check-regional-matrix.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:sepolia": "node ./scripts/run-e2e-sepolia.mjs",
    "check:tokens": "node scripts/check-forbidden-classes.mjs",
    "lighthouse": "npx --yes lighthouse http://localhost:3012 --only-categories=performance --view --output=html --output-path=./.lighthouse-report.html",
    "lighthouse:ci": "npx --yes lighthouse http://localhost:3012 --only-categories=performance --output=json --output-path=./.lighthouse-root.json --chrome-flags=\"--headless --no-sandbox --disable-gpu\"",
    "test:a11y": "npx --yes lighthouse http://localhost:3012 --only-categories=accessibility --view --output=html --output-path=./.lighthouse-a11y-report.html",
    "test:a11y:ci": "npx --yes lighthouse http://localhost:3012 --only-categories=accessibility --output=json --output-path=./.lighthouse-a11y.json --chrome-flags=\"--headless --no-sandbox --disable-gpu\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-virtual": "^3.13.23",
    "@wagmi/connectors": "^2.4.14",
    "framer-motion": "^11.11.17",
    "next": "^15.5.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.170.0",
    "viem": "^2.21.44",
    "wagmi": "^2.12.29"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.14",
    "jsdom": "^25.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "vite": "^6.4.2",
    "ws": "^8.18.2"
  }
}
