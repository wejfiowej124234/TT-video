# TravelTrust 前端（Next.js）环境变量示例
# 复制为 frontend/.env.local 后按需修改；勿提交含密钥的 .env.local。
#
# 与仓库根目录 .env 的关系：
# - 根目录 .env 供 **traveltrust-api**（PORT、DATABASE_URL、CORS_ORIGINS、STRICT_SESSION_GATE 等），见根 .env.example、ops/RUNBOOK.md §10。
# - **浏览器跨域**：当 **NEXT_PUBLIC_API_BASE_URL** 为 **localhost / 127.0.0.1 / [::1]** 时，前端 **`apiUrl()`** 使用**相对路径**，由 **Next.js rewrites**（`next.config.js`）代理到 API，一般**不再依赖**后端 CORS 配页面 origin。若 API 基址为 **host.docker.internal** 等非 loopback，仍须在后端 **CORS_ORIGINS** 中包含前端 origin。
# - 生产 **P4**：API 必须设置 **CORS_ORIGINS** 为真实前端 HTTPS origin 列表（逗号分隔）。
# - API 设 **STRICT_SESSION_GATE=1** 时，受保护接口须 **Authorization: Bearer**（登录返回的 token 存 localStorage `traveltrust_session_token`）；勿依赖仅 `X-User-Id`。**GET /meta** 的 `strict_mode.strict_session_gate` 反映当前值。

# 后端 API 基地址（构建时注入，见 05 §四、53 §3.9.8 BB2）
# dev：须指向 **traveltrust-api** 监听端口（全栈默认 8080），**勿**填成与 Next 相同的端口（3012），否则接口返回 HTML、前端报 api_html_not_json。一键启动会跑 sync-frontend-env-local-from-root 对齐根 .env；若手写本行请与 PORT=8080 一致
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

# 前端站点绝对 origin（无尾路径），供 Next.js metadataBase / OG 绝对 URL；生产必填 HTTPS
# 未设置时开发环境默认 http://127.0.0.1:3012（与 npm run dev 端口一致）
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# WalletConnect v2 项目 ID（在 https://cloud.walletconnect.com 创建）
# 不设置则仅使用注入型钱包（如 MetaMask）
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# 链 ID（Wagmi 目标链、Escrow、WalletStatusMini；与后端 CHAIN_ID 一致，如 Polygon 137、Amoy 80002）
# 不设置时默认 137（Polygon PoS）；本地 Anvil 常用 31337，可配合 NEXT_PUBLIC_RPC_URL
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# FeeRouter（07 §五 5.2A、14 §1.1）：与 Escrow.createEscrow 的 platformFeeRecipient、后端 FEE_ROUTER_ADDRESS、/meta.chain.contracts.fee_router_address 须一致
# NEXT_PUBLIC_FEE_ROUTER_ADDRESS=0x...

# InvestorDistributionClaim（B-087 / P5-4-1）：治理页 `/governance/distribution-claim` 链上 claim/withdraw；须与部署地址一致
# NEXT_PUBLIC_INVESTOR_DISTRIBUTION_CLAIM_ADDRESS=0x...

# EscrowFactory（链上 createEscrow）；与后端 /meta.chain.contracts.escrow_factory_address、NEXT_PUBLIC_* 部署一致
# NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=0x...

# 结算 ERC-20（与后端 SETTLEMENT_TOKEN、行程 canonical snapshot 一致，常用 USDC）
# NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0x...

# Escrow 仲裁员（与部署/运营约定一致）
# NEXT_PUBLIC_ARBITRATOR_ADDRESS=0x...

# 链上争议窗口秒数（可选，默认 604800 = 7 天）
# NEXT_PUBLIC_DISPUTE_WINDOW_SECONDS=604800

# 后端未实现 GET /api/v1/me 时设为 1，不请求该接口，避免控制台 404（业务按未登录处理）
# NEXT_PUBLIC_SKIP_ME_FETCH=1

# 设为 1 时关闭基于路由的 idle prefetch（RoutePrefetcher），减少后台预取请求（弱网/调试时可开）
# NEXT_PUBLIC_DISABLE_IDLE_PREFETCH=1

# 仅本地/无登录联调：无 Bearer 时作为兜底发 **X-User-Id**（见 lib/apiClient/core.ts）。
# 与 **STRICT_SESSION_GATE=1** 互斥：生产或严格门禁下勿用，须走正常登录与会话 token。
# NEXT_PUBLIC_DEV_USER_ID=

# 身份质押双池 + Registry（须与后端 GUIDE_STAKING_ADDRESS / STAKING_PROVIDER_ADDRESS、GET /meta.chain.contracts 一致）
# NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=0x...
# NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=0x...
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...
#
# 与根目录 `.env` 同步：在仓库根复制/维护 `frontend/.env.local`（gitignore），把上列 NEXT_PUBLIC_* 填成与根目录
# FEE_ROUTER_ADDRESS、ESCROW_FACTORY_ADDRESS、CHAIN_ID、CHAIN_RPC_URL、质押与 Registry 地址一致；勿把私钥写入本文件。

# /traveltrust 融资落地页视频（85 §九）：进入视口后挂载 <video>，不自动播放；须 08-4 审查后再填
# NEXT_PUBLIC_TRAVELTRUST_VIDEO_MP4=https://cdn.example.com/tt-story.mp4
# NEXT_PUBLIC_TRAVELTRUST_VIDEO_WEBM=
# NEXT_PUBLIC_TRAVELTRUST_VIDEO_POSTER=

# P-GROW2：信任增长 A/B — 设为 1 时所有触点强制对照组（trustGrowthExperiments.ts 第一档）
# NEXT_PUBLIC_TRUST_EXPERIMENTS_DISABLED=1

# P-GROW3：设为 1 时不上报 ingest（本地调试 / 避免无后端时的请求噪声）
# NEXT_PUBLIC_TRUST_GROWTH_INGEST_DISABLED=1

# P-SCALE1：可选；不设则与 `NEXT_PUBLIC_API_BASE_URL` 同源经 rewrites 访问 `/api/v1/trust-growth/*`
# NEXT_PUBLIC_TRUST_GROWTH_SERVICE_URL=https://trust-growth.example.internal

# S2-API-RO Catalog CMS：=1 时前端可切换读 GET /api/v1/catalog/*（默认 0 · 仍用 cityDetails TS 真源）
# NEXT_PUBLIC_CATALOG_API_ENABLED=0

# Playwright（npm run e2e）：仅起前端、不启 API 时可跳过 e2e/53-main-path.spec.ts；CI 勿设
# PLAYWRIGHT_SKIP_ESCROW_API_TESTS=1
