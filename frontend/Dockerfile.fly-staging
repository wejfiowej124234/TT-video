# tt-web-staging · Next.js standalone（与 deploy/fly/tt-web-staging/Dockerfile 同步）
# NEXT_PUBLIC_* 由 scripts/dev/deploy-tt-web-staging.sh --build-arg 注入

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . ./

ARG NEXT_PUBLIC_API_BASE_URL=https://tt-api-staging.fly.dev
ARG NEXT_PUBLIC_SITE_URL=https://tt-web-staging.fly.dev
ARG API_REWRITE_TARGET=https://tt-api-staging.fly.dev
ARG NEXT_PUBLIC_CHAIN_ID=11155111
ARG NEXT_PUBLIC_RPC_URL=https://sepolia.drpc.org
ARG NEXT_PUBLIC_ESCROW_FACTORY_V2_ADDRESS=
ARG NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=
ARG NEXT_PUBLIC_FEE_ROUTER_ADDRESS=
ARG NEXT_PUBLIC_GOVERNOR_ADDRESS=
ARG NEXT_PUBLIC_REGISTRY_ADDRESS=
ARG NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=
ARG NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=
ARG NEXT_PUBLIC_CATALOG_API_ENABLED=1
ARG NEXT_PUBLIC_TRAVELTRUST_ALLOW_CHAIN_OFF_MOCK_PAY_UI=0
ARG NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=
ARG NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=
ARG NEXT_PUBLIC_PSG_RELEASE_VERSION=PSG-REL-20260722-STAGING-ALIGN-W0
ARG NEXT_PUBLIC_GIT_SHA=
ARG NEXT_PUBLIC_ARTIFACT_SHA=
ARG NEXT_PUBLIC_IMAGE_DIGEST=
ARG NEXT_PUBLIC_BUILD_TIME=
ARG NEXT_PUBLIC_CONTRACT_PROFILE=v311_fund_safety_candidate_v2
ARG NEXT_PUBLIC_DATABASE_BASELINE=staging_rc_ssot_alignment.v1#expected_staging_surface
ARG NEXT_PUBLIC_CMS_BASELINE=public_display_10x4 + catalog_bake=1

ENV NEXT_STANDALONE=1
ARG BUILD_NODE_MAX_OLD_SPACE_SIZE=4096
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV API_REWRITE_TARGET=$API_REWRITE_TARGET
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
# Candidate v2 money-path (ACTIVE create) — EscrowFactoryV2
ENV NEXT_PUBLIC_ESCROW_FACTORY_V2_ADDRESS=$NEXT_PUBLIC_ESCROW_FACTORY_V2_ADDRESS
# V1 factory LEGACY forensic only (not used by getActiveEscrowFactoryAddress)
ENV NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=$NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS
ENV NEXT_PUBLIC_FEE_ROUTER_ADDRESS=$NEXT_PUBLIC_FEE_ROUTER_ADDRESS
ENV NEXT_PUBLIC_GOVERNOR_ADDRESS=$NEXT_PUBLIC_GOVERNOR_ADDRESS
ENV NEXT_PUBLIC_REGISTRY_ADDRESS=$NEXT_PUBLIC_REGISTRY_ADDRESS
ENV NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=$NEXT_PUBLIC_GUIDE_STAKING_ADDRESS
ENV NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=$NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS
ENV NEXT_PUBLIC_CATALOG_API_ENABLED=$NEXT_PUBLIC_CATALOG_API_ENABLED
ENV NEXT_PUBLIC_TRAVELTRUST_ALLOW_CHAIN_OFF_MOCK_PAY_UI=$NEXT_PUBLIC_TRAVELTRUST_ALLOW_CHAIN_OFF_MOCK_PAY_UI
ENV NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=$NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL
ENV NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=$NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES
ENV NEXT_PUBLIC_PSG_RELEASE_VERSION=$NEXT_PUBLIC_PSG_RELEASE_VERSION
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA
ENV NEXT_PUBLIC_ARTIFACT_SHA=$NEXT_PUBLIC_ARTIFACT_SHA
ENV NEXT_PUBLIC_IMAGE_DIGEST=$NEXT_PUBLIC_IMAGE_DIGEST
ENV NEXT_PUBLIC_BUILD_TIME=$NEXT_PUBLIC_BUILD_TIME
ENV NEXT_PUBLIC_CONTRACT_PROFILE=$NEXT_PUBLIC_CONTRACT_PROFILE
ENV NEXT_PUBLIC_DATABASE_BASELINE=$NEXT_PUBLIC_DATABASE_BASELINE
ENV NEXT_PUBLIC_CMS_BASELINE=$NEXT_PUBLIC_CMS_BASELINE

# Phase-4 · Candidate v2 fail-closed: FactoryV2 required for staging money-path create
RUN test -n "$NEXT_PUBLIC_ESCROW_FACTORY_V2_ADDRESS" \
  || (echo "FAIL: NEXT_PUBLIC_ESCROW_FACTORY_V2_ADDRESS required (Candidate v2 EscrowFactoryV2)" >&2 && exit 1)

# Fail-closed: attestation SHA must be non-empty at bake (blocks silent unknown → Fly secret fallback to stale tip)
RUN test -n "$NEXT_PUBLIC_GIT_SHA" \
  || (echo "FAIL: NEXT_PUBLIC_GIT_SHA empty at docker bake — pass --build-arg from deploy-tt-web-staging.sh" >&2 && exit 1)

# Bake-time SSOT file (cannot be overridden by stale Fly secrets TRAVELTRUST_GIT_SHA)
RUN node -e "const fs=require('fs');const o={git_sha:process.env.NEXT_PUBLIC_GIT_SHA||'',artifact_sha:process.env.NEXT_PUBLIC_ARTIFACT_SHA||'',image_digest:process.env.NEXT_PUBLIC_IMAGE_DIGEST||'',build_time:process.env.NEXT_PUBLIC_BUILD_TIME||'',psg_release_version:process.env.NEXT_PUBLIC_PSG_RELEASE_VERSION||'',contract_profile:process.env.NEXT_PUBLIC_CONTRACT_PROFILE||'',database_baseline:process.env.NEXT_PUBLIC_DATABASE_BASELINE||'',cms_baseline:process.env.NEXT_PUBLIC_CMS_BASELINE||'',source:'docker-bake'};fs.mkdirSync('public',{recursive:true});fs.writeFileSync('public/tt-release-identity.bake.json',JSON.stringify(o));console.log('bake-identity',o.git_sha)"

RUN NODE_OPTIONS="--max-old-space-size=${BUILD_NODE_MAX_OLD_SPACE_SIZE}" npm run build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0

RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 8080
CMD ["node", "server.js"]
