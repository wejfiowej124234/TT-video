    "g3_domains_complete": ["G3-01", "G3-02", "G3-03", "G3-04", "G3-05", "G3-06"],
    "artifacts": {
      "go_decision_package_json": "production-go-decision-package.json",
      "final_per": "path under evidence/",
      "production_sign_off": "path under evidence/",
      "launch_checklist": "path under evidence/",
      "launch_approval": "path under evidence/"
    },
    "owner_attestation": {
      "name": "Owner / Release Authority",
      "decision": "GO | NO_GO",
      "signed_utc": "ISO8601"
    }
  },
  "evidence_root": "evidence/GO_production_readiness/production-go-decision",
  "validator": "node scripts/dev/validate-production-go-decision-package.cjs"
