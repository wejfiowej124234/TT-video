    "verdict": "GO | NO_GO",
    "machine_keys": {
      "TT_PRODUCTION_READINESS_G1_GATE": "PASS",
      "TT_PRODUCTION_READINESS_G2_GATE": "PASS",
      "TT_PRODUCTION_READINESS_G3_GATE": "PASS",
      "TT_PRODUCTION_GO": "GO | NO_GO"
