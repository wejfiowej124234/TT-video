{
  "schema": "traveltrust.release_train_reality_verification.v1",
  "version": 2,
  "effective_utc": "2026-07-04",
  "human_runbook": "docs/runbook/TT-RELEASE-TRAIN-REALITY-VERIFICATION.md",
  "release_train_layers": [
    "Platform Frozen",
    "Platform Adoption 100%",
    "Reality Audit",
    "Reality Fix",
    "Platform Coverage Audit",
    "Reality Verification",
    "Evidence Integrity Audit",
    "Formal Acceptance",
    "Gate PASS",
    "G2 Retrospective",
    "Master Reality Audit",
    "G3 Production Domains",
    "Production GO"
  ],
  "release_train_fixed": {
    "effective_utc": "2026-07-04",
    "platform_frozen": true,
    "note": "No new Registry/Guard/Verification Layer/Capability unless Architecture Review Approve",
    "sequence": [
      "Platform Frozen",
      "Platform Adoption 100%",
      "Reality Audit",
      "Reality Fix",
      "Platform Coverage Audit",
      "Reality Verification",
      "Evidence Integrity Audit",
      "Formal Acceptance",
      "Gate PASS",
      "G2 Retrospective",
      "Master Reality Audit",
      "G3 Production Domains",
      "G3 Gate PASS",
      "Production GO Decision Package",
      "Production Retrospective"
    ],
    "distinctions": {
      "reality_verification_complete": "Sets TT_G2_REALITY_VERIFICATION COMPLETE · TT_WAVE2_FORMAL_ACCEPTANCE READY",
      "formal_acceptance_complete": "Sets TT_WAVE2_FORMAL_ACCEPTANCE COMPLETE · enables G2 Gate validate",
      "g2_gate_pass": "Only after Formal Acceptance · validate-production-readiness-g2-gate.cjs exit 0",
      "g2_retrospective_complete": "Sets TT_G2_RETROSPECTIVE COMPLETE · immutable G2 baseline before G3",
      "g3_production_domains_only": "All G3 work in G3-01..G3-06 · registry/g3-production-domains.v1.json · no platform/architecture work",
      "production_go_sole_authority": "TT_PRODUCTION_GO GO only via Production GO Decision Package · validate-production-go-decision-package.cjs",
      "production_retrospective_complete": "Sets TT_PRODUCTION_RETROSPECTIVE COMPLETE · immutable V1 launch baseline after GO"
    }
  },
  "evidence_integrity_audit": {
    "machine_key": "TT_EVIDENCE_INTEGRITY_AUDIT",
    "script": "bash scripts/dev/run-evidence-integrity-audit.sh",
    "validator": "node scripts/dev/validate-evidence-integrity-audit.cjs",
    "runbook": "docs/runbook/TT-EVIDENCE-INTEGRITY-AUDIT.md",
    "position": "after_reality_verification_before_formal",
    "blocks_formal_when_fail": true
  },
  "g2_retrospective": {
    "machine_key": "TT_G2_RETROSPECTIVE",
    "script": "bash scripts/dev/run-g2-retrospective.sh",
    "validator": "node scripts/dev/validate-g2-retrospective.cjs",
    "runbook": "docs/runbook/G2-RETROSPECTIVE.md",
    "position": "after_g2_gate_pass_before_g3",
    "blocks_g3_when_incomplete": true
  },
  "master_reality_audit": {
    "machine_key": "TT_PRODUCTION_READINESS_MASTER_REALITY_AUDIT",
    "script": "bash scripts/dev/run-production-readiness-master-reality-audit.sh",
    "validator": "node scripts/dev/validate-production-readiness-master-reality-audit.cjs",
    "runbook": "docs/runbook/TT-PRODUCTION-READINESS-MASTER-REALITY-AUDIT.md",
    "position": "after_g2_retrospective_before_g3_01",
    "blocks_g3_when_fail": true,
    "output_verdicts": ["VERIFIED", "PLANNED"],
    "g3_entry_rule": "audit CLOSED and all G3-01..G3-06 status PLANNED"
  },
  "g3_production_domains": {
    "registry": "registry/g3-production-domains.v1.json",
    "runbook": "docs/runbook/G3-PRODUCTION-DOMAINS.md",
    "frozen_topics": ["platform", "architecture", "builder", "registry", "guard", "runtime_identity", "pcp"],
    "admission_question": "Does this directly affect Production GO?",
    "domains": ["G3-01", "G3-02", "G3-03", "G3-04", "G3-05", "G3-06"],
    "domain_status_machine": ["PLANNED", "IMPLEMENTING", "VERIFIED", "CLOSED"],
    "per_domain_steps": ["implementation", "reality_verification", "evidence_integrity", "formal_acceptance", "VERIFIED", "matrix_closed"],
    "evidence_layout": {
      "root": "evidence/GO_production_readiness/{domain_id}/",
      "subdirs": ["implementation", "verification", "evidence", "formal"],
      "signoff": "signoff.json"
    },
    "active_domain": "G3-01",
    "verified_evidence_environment": "production_only",
    "forbidden": ["local_or_staging_evidence_as_production_verified"],
    "verification_reuse": ["TT_G3_REALITY_VERIFICATION", "TT_EVIDENCE_INTEGRITY_AUDIT", "TT_WAVE3_FORMAL_ACCEPTANCE"]
  },
  "production_go_decision_package": {
    "template": "registry/production-go-decision-package.v1.template.json",
    "runbook": "docs/runbook/TT-PRODUCTION-GO-DECISION-PACKAGE.md",
    "validator": "node scripts/dev/validate-production-go-decision-package.cjs",
    "sole_authority_for": "TT_PRODUCTION_GO",
    "required_gates": ["TT_PRODUCTION_READINESS_G1_GATE", "TT_PRODUCTION_READINESS_G2_GATE", "TT_PRODUCTION_READINESS_G3_GATE"],
    "domain": "G3-06"
  },
  "production_retrospective": {
    "machine_key": "TT_PRODUCTION_RETROSPECTIVE",
    "script": "bash scripts/dev/run-production-retrospective.sh",
    "validator": "node scripts/dev/validate-production-retrospective.cjs",
    "runbook": "docs/runbook/PRODUCTION-RETROSPECTIVE.md",
    "position": "after_production_go_before_v2_development",
    "requires": ["TT_PRODUCTION_GO: GO", "TT_PRODUCTION_READINESS_G3_GATE: PASS"]
  },
  "platform_coverage_audit": {
    "script": "bash scripts/dev/run-platform-coverage-audit.sh",
    "gate_validator": "node scripts/dev/validate-platform-coverage-gate.cjs",
    "registry": "registry/platform-capability-registry.v1.json",
    "gate_thresholds": {
      "G2": { "runtime_identity": 100, "configuration_truth": 100, "platform_adoption": 100, "unmigrated_modules": 0 },
      "G3": { "runtime_identity": 100, "configuration_truth": 100, "platform_adoption": 100, "unmigrated_modules": 0 }
    },
    "blocks_formal_when_below_target": true
  },
  "truth_sources": [
    "evidence",
    "matrix",
    "registry",
    "configuration",
    "runtime",
    "call_graph"
  ],
  "runtime_identity_module": "scripts/dev/lib/runtime-identity.cjs",
  "configuration_truth_module": "scripts/dev/lib/configuration-truth.cjs",
  "gates": {
    "G1": {
      "label": "Product Verification",
      "machine_keys": {
        "verification": "TT_G1_REALITY_VERIFICATION",
        "formal": "TT_WAVE1_FORMAL_ACCEPTANCE",
        "gate": "TT_PRODUCTION_READINESS_G1_GATE"
      },
      "execute_verification": "bash scripts/dev/run-g1-reality-verification.sh",
      "validate_verification": "node scripts/dev/validate-g1-reality-verification.cjs",
      "production_runtime_identity": { "required": false },
      "configuration_truth": { "required": false, "profile": "staging" },
      "call_graph_anchors": ["RT-COMM-FEED", "RT-COMM-DETAIL", "RT-MKT-DISCOVER"]
    },
    "G2": {
      "label": "Production Hardening",
      "machine_keys": {
        "verification": "TT_G2_REALITY_VERIFICATION",
        "formal": "TT_WAVE2_FORMAL_ACCEPTANCE",
        "gate": "TT_PRODUCTION_READINESS_G2_GATE",
        "runtime_identity": "TT_PRODUCTION_RUNTIME_IDENTITY",
        "configuration_truth": "TT_CONFIGURATION_TRUTH"
      },
      "execute_verification": "bash scripts/dev/run-g2-reality-verification.sh",
      "validate_verification": "node scripts/dev/validate-g2-reality-verification.cjs",
      "production_runtime_identity": {
        "required": true,
        "profile": "production",
        "matrix_gap_on_fail": "PRM-SEC-B002"
      },
      "configuration_truth": { "required": true, "profile": "production" },
      "call_graph_anchors": "all"
    },
    "G3": {
      "label": "Production Cutover",
      "machine_keys": {
        "verification": "TT_G3_REALITY_VERIFICATION",
        "formal": "TT_WAVE3_FORMAL_ACCEPTANCE",
        "gate": "TT_PRODUCTION_READINESS_G3_GATE",
        "runtime_identity": "TT_PRODUCTION_RUNTIME_IDENTITY",
        "configuration_truth": "TT_CONFIGURATION_TRUTH"
      },
      "execute_verification": "bash scripts/dev/run-g3-reality-verification.sh",
      "validate_verification": "node scripts/dev/validate-g3-reality-verification.cjs",
      "production_runtime_identity": {
        "required": true,
        "profile": "production",
        "matrix_gap_on_fail": "PRM-SEC-B002"
      },
      "configuration_truth": { "required": true, "profile": "production" },
      "call_graph_anchors": "all"
    }
  },
  "formal_blocked_when": [
    "any blocker verdict != VERIFIED",
    "six_way_consistent != true",
    "TT_PRODUCTION_RUNTIME_IDENTITY != PASS (when required)",
    "TT_CONFIGURATION_TRUTH != PASS (when required)",
    "TT_G2_REALITY_VERIFICATION != COMPLETE (when required)",
    "TT_EVIDENCE_INTEGRITY_AUDIT != PASS (pre-Formal)"
  ],
  "next_phase_goal": {
    "label": "Platform Adoption 100%",
    "machine_key": "TT_PLATFORM_ADOPTION",
    "allowed_work_classes": [
      "P0_runtime_blocking",
      "P1B_runtime_identity_migration",
      "P1B_configuration_truth_migration",
      "P1C_repository_hygiene"
    ],
    "disallowed_narrative": "新增 XXX architecture"
  }
}
