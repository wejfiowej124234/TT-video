  "production_go_chain": {
    "required_sequence": [
      "G3-01 VERIFIED",
      "G3-02 VERIFIED",
      "G3-03 VERIFIED",
      "G3-04 VERIFIED",
      "G3-05 VERIFIED",
      "G3-06 VERIFIED",
      "Production GO Decision Package",
      "TT_PRODUCTION_GO = GO"
