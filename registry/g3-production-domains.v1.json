    "verification": "TT_G3_REALITY_VERIFICATION",
    "integrity_audit": "TT_EVIDENCE_INTEGRITY_AUDIT",
    "formal": "TT_WAVE3_FORMAL_ACCEPTANCE",
    "gate": "TT_PRODUCTION_READINESS_G3_GATE",
    "decision_package": "production-go-decision-package.v1.json",
