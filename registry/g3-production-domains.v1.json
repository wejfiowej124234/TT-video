      "evidence_root": "evidence/GO_production_readiness/G3-02",
      "runbook": "docs/runbook/PRODUCTION-PAYMENT-READINESS-WEB3-USDC.md",
      "execution_plan": "docs/runbook/G3-02-WEB3-PAYMENT-PRODUCTION-EXECUTION.md",
      "checklist": "registry/production-payment-readiness-checklist.v1.yaml",
      "gate_script": "scripts/check-web3-payment-production-readiness.sh",
