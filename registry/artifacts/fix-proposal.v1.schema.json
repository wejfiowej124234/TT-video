{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traveltrust.fix_proposal.v1",
  "title": "Signed Fix Proposal",
  "type": "object",
  "required": [
    "schema",
    "issue_id",
    "generated_at_utc",
    "patch_type",
    "deployment_state",
    "gate_subset",
    "patch_ref",
    "signed_by"
  ],
  "properties": {
    "schema": { "const": "traveltrust.fix_proposal.v1" },
    "issue_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "patch_type": { "enum": ["unified_diff", "shell_script", "config_overlay"] },
    "patch_ref": {
      "type": "string",
      "description": "Relative path to patch.diff or fix script under proposals/<issue-id>/"
    },
    "deployment_state": { "enum": ["fix"], "description": "Staging deploy must use Fix Deploy only" },
    "fix_deploy_ledger_id": { "type": "string" },
    "gate_subset": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "summary": { "type": "string" },
    "risk": { "enum": ["low", "medium", "high"] },
    "signed_by": { "type": "string", "description": "Owner / Agent attestation id" },
    "honest_boundary": {
      "type": "string",
      "default": "Proposal execution != Production GO"
    }
  },
  "additionalProperties": false
}
