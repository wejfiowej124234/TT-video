+    await tab.click();
+    await expect
+      .poll(
+        async () => {
+          if (sawMatchingGet) return true;
+          if ((await tab.getAttribute("aria-selected")) !== "true") return false;
+          return (await postDrawer.innerText()).includes(commentBody);
+        },
+        { timeout: 90_000, intervals: [200, 400, 800, 1500] },
+      )
+      .toBe(true);
+  } finally {
+    page.off("response", onResponse);
+  }
+}
