+/** 选中国 + 城市 pill（勿用 `.first()` 国家 — catalog 异步重排会点错） */
+async function pickFirstItineraryCountryAndCity(page: Page, days = "1") {
+  const cityGroup = page.getByRole("group", { name: /城市|City/i });
+  const cityButtons = () => cityGroup.getByRole("button");
+
+  if ((await cityButtons().count()) === 0) {
+    const china = page.getByRole("button", { name: "中国", exact: true });
+    await expect(china).toBeVisible({ timeout: 20_000 });
+    await china.scrollIntoViewIfNeeded();
+    await china.click();
+    if ((await cityButtons().count()) === 0) {
+      // pill toggle：已选中时再次点击会清空 destination
+      await china.click();
+    }
+  }
+
+  await expect
+    .poll(async () => cityButtons().count(), { timeout: 60_000, message: "itinerary/new city pills" })
+    .toBeGreaterThan(0);
+
+  const beijing = cityButtons().filter({ hasText: "北京" }).first();
+  if (await beijing.isVisible().catch(() => false)) {
+    await beijing.click();
+  } else {
+    await cityButtons().first().click();
+  }
+
+  if (days !== "1") {
+    await page.locator('input[name="days"]').fill(days);
+  }
+}
+
+async function tryPickItineraryCountryAndCity(page: Page, days = "1"): Promise<boolean> {
+  try {
+    await pickFirstItineraryCountryAndCity(page, days);
+    return true;
+  } catch {
+    return false;
+  }
+}
 
