+  label: string,
+  fn: () => Promise<T>,
+  maxAttempts = process.env.PLAYWRIGHT_E2E_STABILITY === "1" ? 4 : 2,
+): Promise<T> {
+  let lastError: unknown;
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    try {
+      return await fn();
+    } catch (e) {
+      lastError = e;
+      const msg = e instanceof Error ? e.message : String(e);
+      if (attempt >= maxAttempts || !isTransientApiRequestError(msg)) throw e;
+      await new Promise((r) => setTimeout(r, Math.min(2500 * attempt, 12_000)));
+    }
+  }
+  throw lastError instanceof Error ? lastError : new Error(`${label}_failed`);
