+  let lastErr: unknown;
+  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
+    try {
+      await expectCommunityMeGuestInvalidAuthGateOnce(
+        page,
+        path,
+        surfaceDataAttr,
