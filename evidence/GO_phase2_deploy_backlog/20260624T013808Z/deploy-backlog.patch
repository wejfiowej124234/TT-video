+async function hasPaidProviderEntitlement(
+  request: import("@playwright/test").APIRequestContext,
+  apiBase: string,
+  token: string,
+): Promise<boolean> {
+  const entRes = await request.get(`${apiBase}/api/v1/onboarding/entitlements/me`, {
+    headers: { Authorization: `Bearer ${token}` },
+  });
+  if (!entRes.ok()) return false;
+  const ent = (await entRes.json()) as {
+    entitlements?: Array<{ status?: string; role_target?: string; roleTarget?: string }>;
+  };
+  return (
+    ent.entitlements?.some((row) => {
+      const role = (row.role_target ?? row.roleTarget ?? "").toLowerCase();
+      return role === "provider" && row.status === "paid";
+    }) ?? false
+  );
+}
+
+async function markOnboardingIntentPaid(
+  request: import("@playwright/test").APIRequestContext,
+  apiBase: string,
+  token: string,
+  idem: string,
+): Promise<void> {
+  const markPaidRes = await request.post(`${apiBase}/api/v1/onboarding/local-dev/mark-paid`, {
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+    },
+    data: { idempotency_key: idem },
+  });
+  if (markPaidRes.ok()) return;
+
+  const secret =
+    process.env.PLAYWRIGHT_INTERNAL_API_SECRET?.trim() || process.env.INTERNAL_API_SECRET?.trim();
+  if (!secret) {
+    throw new Error(
+      `onboarding mark-paid failed HTTP ${markPaidRes.status()} and INTERNAL_API_SECRET unset`,
+    );
+  }
+
+  const webhookPayload = {
+    schema_version: 1,
+    idempotency_key: idem,
+    provider_event_id: `evt_mkt_studio_${idem.replace(/-/g, "").slice(0, 12)}`,
+    outcome: "succeeded",
+  };
+  const rawBody = JSON.stringify(webhookPayload);
+  const hmacSecret = process.env.ONBOARDING_WEBHOOK_HMAC_SECRET?.trim();
+  const xff =
+    process.env.PLAYWRIGHT_ONBOARDING_WEBHOOK_X_FORWARDED_FOR?.trim() ||
+    process.env.ONBOARDING_WEBHOOK_X_FORWARDED_FOR?.trim() ||
+    "127.0.0.1";
+  const xfProto =
+    process.env.PLAYWRIGHT_ONBOARDING_WEBHOOK_X_FORWARDED_PROTO?.trim() ||
+    process.env.ONBOARDING_WEBHOOK_X_FORWARDED_PROTO?.trim() ||
+    "https";
+  const whHeaders: Record<string, string> = {
+    "Content-Type": "application/json",
+    "X-Internal-Api-Secret": secret,
+    "X-Forwarded-For": xff,
+    "X-Forwarded-Proto": xfProto,
+  };
+  if (hmacSecret) {
+    const hex = createHmac("sha256", hmacSecret).update(rawBody).digest("hex");
+    whHeaders["X-Onboarding-Webhook-Signature"] = `v1=${hex}`;
+  }
+  const whRes = await request.post(`${apiBase}/api/v1/internal/onboarding/payments/webhook`, {
+    headers: whHeaders,
+    data: rawBody,
+  });
+  if (!whRes.ok()) {
+    throw new Error(`onboarding webhook failed: ${whRes.status()} ${await whRes.text()}`);
+  }
+}
+
+/** ① studio E2E：`MerchantShowcaseStudioModal` 发布门闸（paid provider entitlement） */
+export async function ensureMerchantStudioPublishReady(
+  request: import("@playwright/test").APIRequestContext,
+  apiBase: string,
+  token: string,
+): Promise<void> {
+  if (await hasPaidProviderEntitlement(request, apiBase, token)) return;
+
+  const idem = randomUUID();
+  const piRes = await request.post(`${apiBase}/api/v1/onboarding/payment-intents`, {
+    headers: {
+      Authorization: `Bearer ${token}`,
+      "Content-Type": "application/json",
+      "Idempotency-Key": idem,
+    },
+    data: { role: "provider" },
+  });
+  if (!piRes.ok()) {
+    throw new Error(`payment-intents failed: ${piRes.status()} ${await piRes.text()}`);
+  }
+
+  await markOnboardingIntentPaid(request, apiBase, token, idem);
+
+  if (!(await hasPaidProviderEntitlement(request, apiBase, token))) {
+    throw new Error("merchant studio publish prereqs: entitlements/me still missing paid provider");
+  }
+}
