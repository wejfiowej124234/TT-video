+
+function guestAuthGatePathMatches(page: Page, path: string): boolean {
+  try {
+    const current = new URL(page.url());
+    const want = new URL(path, current.origin);
+    return current.pathname.replace(/\/+$/, "") === want.pathname.replace(/\/+$/, "");
+  } catch {
+    return page.url().includes(path);
+  }
