+  {
+    path: "/community/me/reports",
+    surfaceDataAttr: "community_me_reports_auth_gate",
+    pageDataAttr: "reports",
+  },
+  {
+    path: "/community/me/posts",
+    surfaceDataAttr: "community_me_posts_auth_gate",
