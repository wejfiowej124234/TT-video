+fn itinerary_custom_draft_payload_from_body(body: &Value) -> Result<Value, axum::response::Response> {
+    let payload = body.get("payload").cloned().unwrap_or(Value::Null);
+    if !payload.is_object() {
+        return Err((
+            StatusCode::BAD_REQUEST,
+            Json(json!({
+                "status": "error",
+                "error": "invalid_itinerary_custom_draft_payload",
+                "message": "invalid_itinerary_custom_draft_payload",
+                "reason": "payload_must_be_object",
+            })),
+        )
+            .into_response());
+    }
+    Ok(payload)
+}
+
+fn itinerary_custom_draft_requires_db() -> impl IntoResponse {
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        Json(json!({
+            "status": "error",
+            "error": "database_required",
+            "message": "database_required",
+            "reason": "DATABASE_URL is not configured; itinerary custom drafts unavailable",
+        })),
+    )
+}
+
+fn itinerary_custom_draft_db_persist_failed(reason: &str) -> impl IntoResponse {
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        Json(json!({
+            "status": "error",
+            "error": "itinerary_custom_draft_db_persist_failed",
+            "message": "itinerary_custom_draft_db_persist_failed",
+            "reason": reason,
+        })),
+    )
+}
+
+fn itinerary_custom_draft_db_read_failed(reason: &str) -> impl IntoResponse {
+    (
+        StatusCode::SERVICE_UNAVAILABLE,
+        Json(json!({
+            "status": "error",
+            "error": "itinerary_custom_draft_db_read_failed",
+            "message": "itinerary_custom_draft_db_read_failed",
+            "reason": reason,
+        })),
+    )
+}
+
+/// POST /api/v1/itineraries/custom/drafts：49 A 创作台草稿 PG 持久化（D-ITN-003 / F-033）
+pub async fn itinerary_custom_draft_post(
+    State(state): State<ApiMetaState>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> impl IntoResponse {
+    let owner_uid =
+        match require_session_user(extract_user_with_session_check(&state, &headers).await) {
+            Ok(u) => u,
+            Err(e) => return e.into_response(),
+        };
+    let Some(co) = state.chain_off.as_ref() else {
+        return (
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(json!({
+                "status": "error",
+                "error": "chain_off_unavailable",
+                "message": "chain_off_unavailable",
+            })),
+        )
+            .into_response();
+    };
+    if let Err((code, j)) = chain_off::ensure_durable_writes_available(co) {
+        return (code, j).into_response();
+    }
+    let Some(pool) = co.db_pool.as_ref() else {
+        return itinerary_custom_draft_requires_db().into_response();
+    };
+    let payload = match itinerary_custom_draft_payload_from_body(&body) {
+        Ok(p) => p,
+        Err(resp) => return resp,
+    };
+    let draft_id = Uuid::new_v4();
+    let saved_at = Utc::now();
+    match db::insert_itinerary_custom_draft(pool, draft_id, owner_uid, &payload, saved_at).await {
+        Ok(1) => (
+            StatusCode::OK,
+            Json(json!({
+                "status": "ok",
+                "draft_id": draft_id.to_string(),
+                "saved_at": saved_at.to_rfc3339(),
+                "meta": { "implementation_status": "itinerary_custom_drafts_db" }
+            })),
+        )
+            .into_response(),
+        Ok(n) => {
+            eprintln!("WARN: itinerary_custom_draft_insert_unexpected_rows_affected: {n}");
+            itinerary_custom_draft_db_persist_failed(
+                "itinerary_custom_draft_insert_unexpected_rows",
+            )
+            .into_response()
+        }
+        Err(e) => {
+            eprintln!("WARN: itinerary_custom_draft_insert_failed: {e}");
+            itinerary_custom_draft_db_persist_failed("itinerary_custom_draft_insert_failed")
+                .into_response()
+        }
+    }
+}
+
+/// GET /api/v1/itineraries/custom/drafts/:id（D-ITN-003 / F-033）
+pub async fn itinerary_custom_draft_get(
+    State(state): State<ApiMetaState>,
+    Path(draft_id): Path<String>,
+    headers: HeaderMap,
+) -> impl IntoResponse {
+    let Ok(uid) = Uuid::parse_str(draft_id.trim()) else {
+        return (
+            StatusCode::BAD_REQUEST,
+            Json(json!({"error": "invalid_uuid", "message": "invalid_uuid"})),
+        )
+            .into_response();
+    };
+    let Some(co) = state.chain_off.as_ref() else {
+        return (
+            StatusCode::SERVICE_UNAVAILABLE,
+            Json(json!({
+                "status": "error",
+                "error": "chain_off_unavailable",
+                "message": "chain_off_unavailable",
+            })),
+        )
+            .into_response();
+    };
+    let Some(pool) = co.db_pool.as_ref() else {
+        return itinerary_custom_draft_requires_db().into_response();
+    };
+    let owner_uid =
+        match require_session_user(extract_user_with_session_check(&state, &headers).await) {
+            Ok(u) => u,
+            Err(e) => return e.into_response(),
+        };
+    match db::select_itinerary_custom_draft_by_id_for_owner(pool, uid, owner_uid).await {
+        Ok(None) => (
+            StatusCode::NOT_FOUND,
+            Json(json!({
+                "status": "error",
+                "error": "itinerary_custom_draft_not_found",
+                "message": "itinerary_custom_draft_not_found",
+                "draft_id": draft_id.trim(),
+            })),
+        )
+            .into_response(),
+        Ok(Some(row)) => (
+            StatusCode::OK,
+            Json(json!({
+                "status": "ok",
+                "draft_id": row.id.to_string(),
+                "saved_at": row.saved_at.to_rfc3339(),
+                "payload": row.payload,
+            })),
+        )
+            .into_response(),
+        Err(e) => {
+            eprintln!("WARN: itinerary_custom_draft_select_failed: {e}");
+            itinerary_custom_draft_db_read_failed("itinerary_custom_draft_select_failed")
+                .into_response()
+        }
+    }
+}
+
 pub fn router() -> Router<ApiMetaState> {
     Router::new()
+        .route(
+            "/api/v1/itineraries/custom/drafts",
+            post(itinerary_custom_draft_post),
+        )
+        .route(
+            "/api/v1/itineraries/custom/drafts/:id",
+            get(itinerary_custom_draft_get),
+        )
         .route("/api/v1/itineraries/custom", post(itinerary_custom_create))
         .route("/api/v1/itineraries", post(itinerary_create))
 }
