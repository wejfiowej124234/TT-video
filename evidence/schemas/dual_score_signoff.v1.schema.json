{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traveltrust.local/schemas/dual_score_signoff.v1.schema.json",
  "title": "TravelTrust Check-G · dual_score_signoff.v1",
  "description": "Machine-readable seven-dimension quality scores + execution snapshot for Runbook §2.7.4 Check-G. See ops/RUNBOOK.md#check-g-dual-score-gate.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_id",
    "date",
    "stage",
    "execution_snapshot",
    "g1_pass",
    "dimensions",
    "sign_off"
  ],
  "properties": {
    "schema_id": {
      "type": "string",
      "const": "traveltrust.dual_score_signoff.v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "stage": {
      "type": "string",
      "enum": ["test_internal", "pre_go", "go_external"],
      "description": "G2 minimum per dimension: test_internal≥7, pre_go≥8, go_external≥9"
    },
    "execution_snapshot": {
      "type": "object",
      "required": ["combined_percent", "source_note"],
      "properties": {
        "combined_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "source_note": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "g1_pass": { "type": "boolean" },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "score"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 7 },
          "key": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "note": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension_id", "score", "min_required", "reason", "approver"],
        "properties": {
          "dimension_id": { "type": "integer", "minimum": 1, "maximum": 7 },
          "score": { "type": "number" },
          "min_required": { "type": "number" },
          "reason": { "type": "string", "minLength": 1 },
          "approver": { "type": "string", "minLength": 1 },
          "date": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "sign_off": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "human_readable_md_path": {
      "type": "string",
      "description": "Optional pointer to dual-score-signoff.md in same GO bundle"
    },
    "meta": {
      "type": "object",
      "description": "P0: bind this file to the same GO bundle manifest.json",
      "properties": {
        "manifest_ref": {
          "type": "string",
          "description": "Stable pointer e.g. manifest.json#dual_score"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA256 of manifest.json bytes (lowercase hex)"
        }
      },
      "additionalProperties": true
    },
    "g1_snapshot": {
      "type": "object",
      "description": "P1: G1 execution % SSOT pointer (same file as G2)",
      "required": ["spec_version", "overall_percent", "source"],
      "properties": {
        "spec_version": { "type": "string", "minLength": 1 },
        "overall_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "description": "P1: audit trail pointers (filenames, PR, TT ids)",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
