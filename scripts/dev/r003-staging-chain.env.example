# R-003 证据链：复制为 scripts/dev/.env.r003.local 后填写（该文件被 .gitignore 忽略，勿提交）。
# Cursor：`Tasks: Run Task` → `R-003: staging evidence chain (env)`，或仓库根：
#   python scripts/dev/run_r003_staging_evidence_chain.py --from-env
# CI：GitHub Actions → `R-003 staging evidence chain (dispatch)`；Secrets 名见
#   `.github/workflows/r003-staging-evidence-chain-dispatch.yml`（R003_STAGING_*）。
# 预检：填毕后 `python scripts/dev/check_r003_staging_env_ready.py`
#
# --- 真实 staging 首轮（唯一交付路径；勿设 R003_LOCAL_CHAIN）---
R003_API_BASE=https://YOUR-STAGING-API.example
R003_ENVIRONMENT_NAME=staging
R003_OUT=evidence/GO_phase2_testnet_20260526
R003_EXECUTOR=your.name@company.com
R003_A_EMAIL=tourist@test.com
R003_A_PASSWORD=

# --- 本机烟测（与 staging 首轮二选一）：取消上行 staging 填写并启用下行 ---
# R003_LOCAL_CHAIN=1
# 启用后：证据链会强制 R003_ENVIRONMENT_NAME=local、R003_OUT=evidence/R003_local_evidence_chain；
# 若 R003_API_BASE 仍为上方占位 URL，则自动改用 http://127.0.0.1:8080（勿与 staging 首轮混用）。

# 仅当 staging + api-base 故意指向本机/回环解析时设为 1
# R003_WARN_LOCALHOST=1
