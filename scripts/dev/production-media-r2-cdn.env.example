# Phase ③ Production · Cloudflare R2 + CDN (copy → .env.production-media-r2.local · 勿提交)
#
#   cp scripts/dev/production-media-r2-cdn.env.example scripts/dev/.env.production-media-r2.local
#   PRODUCTION_CDN_DRY_RUN=0 bash scripts/dev/configure-production-media-r2-cdn.sh
#
# SSOT: registry/g3-production-cdn-official-assets.v1.json

FLY_API_APP=tt-api-prod
FLY_WEB_APP=tt-web-prod

COMMUNITY_MEDIA_S3_BUCKET=traveltrust-community-media
COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=https://cdn.traveltrust.app
COMMUNITY_MEDIA_S3_ENDPOINT=
COMMUNITY_MEDIA_S3_REGION=auto
COMMUNITY_MEDIA_S3_FORCE_PATH_STYLE=0
COMMUNITY_MEDIA_S3_KEY_PREFIX=community-media/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=https://cdn.traveltrust.app

# Official Asset Baseline V1 CDN prefix (R2 keys under official-cold-start/v1/)
OCS_OFFICIAL_CDN_PREFIX=official-cold-start/v1

NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=https://cdn.traveltrust.app
NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=https://cdn.traveltrust.app

# Production web origins (CORS lock at cutover)
PRODUCTION_WEB_ORIGINS=https://traveltrust.app,https://www.traveltrust.app
