# Production Infrastructure · secrets / env 清单（③ · 勿提交真实值）
#
#   cp scripts/dev/.env.production.example scripts/dev/.env.production.local
#   # 填实后：
#   bash scripts/dev/phase3-production-fly-deploy-and-sync.sh --secrets-only
#
# SSOT：docs/runbook/PRODUCTION-OPS-RUNBOOK.md §5 · go-live-checklist §3

# --------- 必填（Production GO Blocker）---------
# DATABASE_URL=postgres://...@tt-traveltrust-prod.internal:5432/...
# INTERNAL_API_SECRET=<强随机 · WAF 禁公网 /api/v1/internal/* · CFG-001 须与 ①② 隔离>
# CORS_ORIGINS=https://app.<your-domain>   # 仅 prod FE origin，禁止 *
# SEED_TEST_ACCOUNTS=0                    # CFG-026 · 生产必须 0
# P3_CHAIN_OFF=   # 必须 unset / 0

# --------- 链（按 scope：Sepolia prod 或 Mainnet §9）---------
# CHAIN_RPC_URL=
# CHAIN_ID=11155111
# ESCROW_FACTORY_ADDRESS=
# FEE_ROUTER_ADDRESS=
# REGION_VAULT_ADDRESS=
# REGISTRY_ADDRESS=
# GOVERNOR_ADDRESS=
# GOVERNANCE_TOKEN_ADDRESS=
# GUIDE_STAKING_ADDRESS=
# STAKING_PROVIDER_ADDRESS=

# --------- Stripe Live（PI3-003 · 本文件仅登记）---------
# TRAVELTRUST_STRIPE_SECRET_KEY=sk_live_...
# TRAVELTRUST_STRIPE_WEBHOOK_SECRET=whsec_...
# TRAVELTRUST_ONBOARDING_STRIPE_ENABLED=1

# --------- SSOT 硬化（go-live §3.3 · 生产建议）---------
# STRICT_SSOT=1
# SSOT_VERSION=
# SSOT_SHA256=
# CHARGEBACK_POLICY=
# STRICT_SESSION_GATE=1
# REQUIRE_IDEMPOTENCY_KEY=1

# --------- 发布追溯（go-live §0.1）---------
# TRAVELTRUST_GIT_SHA=
# PUBLIC_API_BASE_URL=https://api.<your-domain>

# --------- CFG-027 · ③ 硬化预演（隔离环境 · 勿与 ① 日常 .env 混用）---------
# cp .env.preprod.local.example .env.preprod.local
# bash scripts/dev/check-strict-ssot-local-prereqs.sh
# bash scripts/dev/verify-cfg-drift-closure.sh --batch B4

# --------- CFG-028 · prod FE build 对拍 ---------
# cp deploy/fly/tt-web-prod/build.env.example deploy/fly/tt-web-prod/build.env.local
# 部署后：curl -s https://api.<domain>/meta 与 build.env.local NEXT_PUBLIC_* 对拍

# --------- Fly app 名（默认）---------
# FLY_PROD_API_APP=tt-api-prod
# FLY_PROD_WEB_APP=tt-web-prod
# FLY_PROD_PG_APP=tt-traveltrust-prod
# PROD_API_BASE=https://api.<your-domain>
# PROD_WEB_BASE=https://app.<your-domain>
