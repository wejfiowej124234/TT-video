# Phase ② · staging 密钥（勿提交 · gitignore: .env.*）
# 复制为 scripts/dev/.env.staging-secrets.local 后填写 Stripe test 密钥。
#
#   cp scripts/dev/staging-secrets.env.example scripts/dev/.env.staging-secrets.local
#
# 填毕后：
#   bash scripts/dev/bootstrap-phase2-g1-g2.sh

TRAVELTRUST_STRIPE_SECRET_KEY=sk_test_REPLACE_ME
TRAVELTRUST_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# 可选：与 ① 不同的 staging 内网 webhook 密钥（推荐独立值）
# INTERNAL_API_SECRET=
