# Phase ② · staging onboarding / Stripe / webhook（勿提交 · 复制为 .env.staging-onboarding.local）
#
#   cp scripts/dev/staging-onboarding.env.example scripts/dev/.env.staging-onboarding.local
#
# 填毕后：
#   bash scripts/dev/check-phase2-onboarding-staging-ready.sh
#   bash scripts/dev/smoke-onboarding-testnet.sh   # G-0～G-4 绿 + staging 可达后
#
# 决策书 SSOT：docs/runbook/PHASE2-G1-ENV-ISOLATION-DECISION.md

# --- G-2 · staging API（须 HTTPS · 机读键名 API_BASE；与 API_BASE_URL 同义）---
API_BASE=https://YOUR-STAGING-API.example
# API_BASE_URL=https://YOUR-STAGING-API.example
# 持久 staging 示例（须已部署且 /health=200）：https://tt-api-staging.fly.dev
# 本机 API 无公网时：STAGING_USE_LOCAL_TUNNEL=1 bash scripts/dev/bootstrap-phase2-g1-g2.sh
# 仅本机调试且明确接受风险时：
# TRAVELTRUST_ALLOW_INSECURE_HTTP_BASE=1

# --- G-2 · staging PG（migrate 与 ① 同版镜像 · 与 ① traveltrust 库零共享）---
DATABASE_URL=postgresql://traveltrust:traveltrust@127.0.0.1:5432/traveltrust_staging
# 远端 staging：postgresql://user:pass@staging-host:5432/traveltrust_staging
# 空库→最新证据：bash scripts/dev/record-phase2-g2-staging-sqlx-migrate-evidence.sh

# --- 社区对象存储（② C4/C5 · 与 COMMUNITY-MEDIA-OBJECT-STORAGE.md 同源）---
# COMMUNITY_MEDIA_S3_BUCKET=
# COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=
# COMMUNITY_MEDIA_S3_ENDPOINT=
# COMMUNITY_MEDIA_S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- G-1 · Stripe test（与 prod live 零混用 · 建议写入 .env.staging-secrets.local）---
# 见 scripts/dev/staging-secrets.env.example → .env.staging-secrets.local（勿提交）
TRAVELTRUST_ONBOARDING_STRIPE_ENABLED=1
TRAVELTRUST_STRIPE_SECRET_KEY=sk_test_...
TRAVELTRUST_STRIPE_WEBHOOK_SECRET=whsec_...
# 可选 Checkout：
# TRAVELTRUST_ONBOARDING_STRIPE_CHECKOUT=1

# --- G-4 · 禁止 staging 零金额（须在 staging API 进程环境中 unset 或 =0）---
# TRAVELTRUST_ONBOARDING_LOCAL_DEV=0

# --- 内网 JSON webhook（staging 策略允许时；非 Stripe ② 充分证据）---
INTERNAL_API_SECRET=
# ONBOARDING_WEBHOOK_HMAC_SECRET=
# ONBOARDING_WEBHOOK_X_FORWARDED_FOR=
# ONBOARDING_WEBHOOK_X_FORWARDED_PROTO=https

# --- ONB-P2-005 四方对拍（读回 Stripe PI.amount）---
# STRIPE_SECRET_KEY 可与 TRAVELTRUST_STRIPE_SECRET_KEY 同源 sk_test_

# --- 证据输出 ---
PHASE2_EVIDENCE_DIR=evidence/GO_phase2_testnet_20260526
