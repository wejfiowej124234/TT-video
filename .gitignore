# 构建与依赖
/target
**/target
dist
Cargo.lock
.cargo-home-mig-evidence/

# Foundry（合约构建产物，本地 `forge build` 再生）
contracts/out/
contracts/cache/
contracts/broadcast/

# 前端（Next.js）
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.lighthouse*

# P-GROW3/P-SCALE1：历史遗留本地目录（旧版 Next 文件存储）；运行时权重已迁 Postgres
frontend/.data/

# 环境与密钥（勿提交）
.env
.env.*
!.env.example
*.pem
*.key
*credentials*

# Windows 设备保留名：若出现在仓库根，会导致 `git add` 索引失败（须删除并勿再创建）
/nul

# 备份与本地
**/*.rs.bk
*.bak
*.tmp
.smoke_ab_body.json
.dev_backend.pid
.dev_frontend.pid

# 本地工具目录（如 jq.exe 等缓存，不入库）
.tools/

# 本地 gate / 工具缓存目录（勿入仓）
.tmp-gate-bin/

# API 包内本地数据/上传烟测产物（勿入仓；与 `frontend/.data/` 同类）
crates/api/data/

# API 本机运行时暂存（索引/审计 JSON；勿入仓）
crates/api/test.runtime

# 93 管理深测批次的本机导出（按时间戳子目录；勿整仓堆积）
evidence/93-batch-admin-deep-audit/run_*/

# 社区发帖媒体本地上传（API 进程 CWD 通常为仓库根 `data/`；勿入仓）
data/community_post_media/

# Python 字节码（勿提交）
**/__pycache__/
*.py[cod]

# 日志默认不入仓；evidence 下 Forge 专验日志白名单入仓（封口/里程碑，见 docs/solo-dev-rhythm.md）
*.log
!evidence/**/forge_*.log

# R-003：本机 LOCAL_CHAIN 烟测输出（非 staging 首轮 GO 证据）
evidence/R003_local_evidence_chain/

# 本地另存 `CARGO_TARGET_DIR` 的构建树（勿入仓；体积极大）
target-r003-evidence/

# Playwright 本地报告（勿入仓）
frontend/playwright-report/
frontend/test-results/
