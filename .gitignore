# 构建与依赖
/target
**/target
dist
Cargo.lock

# Foundry（合约构建产物，本地 `forge build` 再生）
contracts/out/
contracts/cache/
contracts/broadcast/

# 前端（Next.js）
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.lighthouse*

# 环境与密钥（勿提交）
.env
.env.*
!.env.example
*.pem
*.key
*credentials*

# Windows 设备保留名：若出现在仓库根，会导致 `git add` 索引失败（须删除并勿再创建）
/nul

# 备份与本地
**/*.rs.bk
*.bak
*.tmp
.dev_backend.pid
.dev_frontend.pid

# 脚本运行产生的日志（留痕由 CI/人工执行后生成）
scripts/*.log

# 真实 evidence bundle（过门时产出，可能含内部信息；模板与 README 可提交）
evidence/GO_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]/
