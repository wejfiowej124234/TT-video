index 0000000..46d1a41
--- /dev/null
+++ b/.github/workflows/production-gate.yml
@@ -0,0 +1,319 @@
+# Production gate — Enforcement layer（Policy: docs/ci/CI-REQUIRED-PRODUCTION-GATE.md）
+# SSOT: gates/production_gate.yaml + Gate Audit 机器清单 gates/gate_audit.machine.json（42+43=85）
+# 校验: python3 scripts/gates/verify_production_gate_config.py
+# PR/push 默认触发；子 job 不设 continue-on-error；96-15 可 gates/waivers/96-15.waiver.json 豁免。
+name: Production gate
+
+on:
+  pull_request:
+    branches: [main]
+  push:
+    branches: [main]
+
+concurrency:
+  group: production-gate-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.ref != 'refs/heads/main' }}
+
+permissions:
+  contents: read
+
+jobs:
+  verify-gate-config:
+    name: Verify gates/production_gate.yaml (SSOT)
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v6
+      - name: verify_production_gate_config.py
+        run: python3 scripts/gates/verify_production_gate_config.py
+
+  b421-doclink:
+    name: B-421 runbook / go-live doclink
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v6
+      - name: B-421 six-path gate
+        run: bash scripts/check-runbook-golive-doclink-gate.sh
+
+  broadcast-all:
+    name: Legacy SSOT + broadcast batches 1–3
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v6
+      - name: broadcast-batch-all-required
+        run: bash scripts/gates/broadcast-batch-all-required.sh
+
+  traveltrust-api-tests:
+    name: traveltrust-api (cargo test)
+    runs-on: ubuntu-latest
+    timeout-minutes: 90
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_USER: traveltrust
+          POSTGRES_PASSWORD: traveltrust
+          POSTGRES_DB: traveltrust
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U traveltrust -d traveltrust"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 12
+    env:
+      DATABASE_URL: postgres://traveltrust:traveltrust@127.0.0.1:5432/traveltrust
+    steps:
+      - uses: actions/checkout@v6
+      - uses: dtolnay/rust-toolchain@master
+        with:
+          toolchain: stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: traveltrust-production-gate-api-${{ runner.os }}
+      - name: cargo test -p traveltrust-api
+        env:
+          TRAVELTRUST_BUILD_GIT_SHA: ${{ github.sha }}
+          CARGO_INCREMENTAL: "0"
+        run: cargo test -p traveltrust-api
+
+  tier-96-15:
+    name: 96-15 Tier A–C machine (or waiver)
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v6
+      - name: Resolve 96-15 waiver
+        id: waiver
+        run: python3 scripts/gates/resolve_96_15_waiver.py
+      - name: 96-15 booklets + orchestration
+        if: steps.waiver.outputs.skip_96_15 != 'true'
+        env:
+          GITHUB_RUN_ID: ${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          OUT="evidence/GO_96_15_pr_${GITHUB_RUN_ID}"
+          mkdir -p "$OUT/deep_evidence"
+          python3 scripts/release/verify_96_booklets_registry.py --out "$OUT/96_booklets_registry.json"
+          python3 scripts/release/run_96_15_orchestration.py \
+            --out-dir "$OUT" \
+            --executor "github-actions-${GITHUB_RUN_ID}" \
+            --tier-a1-readme gates/tier_a_ci/README.md \
+            --tier-a2-markdown gates/tier_a_ci/59_p0_table.md \
+            --require-tier-a-semiauto \
+            --require-tier-a-all-pass \
+            --require-tier-bc-all-pass
+      - name: 96-15 skipped (waiver)
+        if: steps.waiver.outputs.skip_96_15 == 'true'
+        run: 'echo "::notice::tier-96-15 skipped per active gates/waivers/96-15.waiver.json"'
+      - name: Upload 96-15 evidence
+        uses: actions/upload-artifact@v4
+        if: success() && steps.waiver.outputs.skip_96_15 != 'true'
+        with:
+          name: production-gate-96-15-${{ github.run_id }}
+          path: evidence/GO_96_15_pr_${{ github.run_id }}/**
+          retention-days: 30
+
+  report-policy:
+    name: report.json policy (PARTIAL sunset + single final truth)
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+      - name: check_pr_partial_go_expiry.py
+        env:
+          GITHUB_EVENT_NAME: ${{ github.event_name }}
+          GITHUB_BASE_REF: ${{ github.base_ref }}
+          GITHUB_EVENT_BEFORE: ${{ github.event.before }}
+          GITHUB_SHA: ${{ github.sha }}
+        run: python3 scripts/gates/check_pr_partial_go_expiry.py
+      - name: check_report_single_truth.py
+        env:
+          GITHUB_EVENT_NAME: ${{ github.event_name }}
+          GITHUB_BASE_REF: ${{ github.base_ref }}
+          GITHUB_EVENT_BEFORE: ${{ github.event.before }}
+          GITHUB_SHA: ${{ github.sha }}
+        run: python3 scripts/gates/check_report_single_truth.py
+      - name: check_pr_final_truth_presence.py
+        env:
+          GITHUB_EVENT_NAME: ${{ github.event_name }}
+          GITHUB_BASE_REF: ${{ github.base_ref }}
+          GITHUB_EVENT_BEFORE: ${{ github.event.before }}
+          GITHUB_SHA: ${{ github.sha }}
+        run: python3 scripts/gates/check_pr_final_truth_presence.py
+
+  e2e-r002-93:
+    name: Playwright + R-002 ISS-007 validate (fail-closed)
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    services:
+      postgres:
+        image: postgres:16-alpine
+        env:
+          POSTGRES_USER: traveltrust
+          POSTGRES_PASSWORD: traveltrust
+          POSTGRES_DB: traveltrust
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U traveltrust -d traveltrust"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 12
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-node@v4
+        with:
+          node-version: "20"
+          cache: "npm"
+          cache-dependency-path: frontend/package-lock.json
+      - name: Set evidence dir
+        run: echo "EVIDENCE_DIR=evidence/GO_$(date +%Y%m%d)" >> "$GITHUB_ENV"
+      - name: Install frontend deps
+        run: cd frontend && npm ci
+      - name: Install Playwright browsers
+        run: cd frontend && npx playwright install --with-deps chromium
+      - name: Build frontend
+        run: cd frontend && npm run build
+      - uses: dtolnay/rust-toolchain@master
+        with:
+          toolchain: stable
+      - uses: Swatinem/rust-cache@v2
+        with:
+          shared-key: traveltrust-production-gate-e2e-${{ runner.os }}
+      - name: Build traveltrust-api (E2E rewrite target)
+        env:
+          TRAVELTRUST_BUILD_GIT_SHA: ${{ github.sha }}
+          CARGO_INCREMENTAL: "0"
+        run: cargo build -p traveltrust-api
+      - name: Start API on 8080 for E2E
+        env:
+          PORT: "8080"
+          SEED_TEST_ACCOUNTS: "1"
+          P3_CHAIN_OFF: "1"
+          API_RATE_LIMIT_PER_MINUTE: "0"
+          CRITICAL_WRITE_RATE_LIMIT_PER_MINUTE: "0"
+          P3_SEED_ARBITRATOR_EMAIL: "e2e-ci-arbitrator-seed@traveltrust.test"
+          TRAVELTRUST_BUILD_GIT_SHA: ${{ github.sha }}
+          DATABASE_URL: postgres://traveltrust:traveltrust@127.0.0.1:5432/traveltrust
+          CHAIN_RPC_URL: ""
+        run: |
+          set -euo pipefail
+          ./target/debug/traveltrust-api > /tmp/traveltrust-api-e2e.log 2>&1 &
+          for i in $(seq 1 120); do
+            if curl -sf "http://127.0.0.1:8080/health" >/dev/null; then
+              echo "API ready on :8080"
+              exit 0
+            fi
+            sleep 1
+          done
+          echo "API did not become ready on :8080"
+          cat /tmp/traveltrust-api-e2e.log || true
+          exit 1
+      - name: E2E (Playwright)
+        id: e2e_playwright
+        env:
+          PORT: "3012"
+          PLAYWRIGHT_BASE_URL: "http://localhost:3012"
+          DATABASE_URL: postgres://traveltrust:traveltrust@127.0.0.1:5432/traveltrust
+          PLAYWRIGHT_ARBITRATOR_SEED_EMAIL: "e2e-ci-arbitrator-seed@traveltrust.test"
+          PLAYWRIGHT_RELAX_META_CHAIN_GUARD: "1"
+          STRICT_SESSION_GATE: "1"
+        run: cd frontend && npm run e2e -- --project=chromium --grep-invert "@e2e-sepolia-deferred"
+      - name: R-002 ISS-007 narrow slice + validate-regression-report
+        env:
+          DATABASE_URL: postgres://traveltrust:traveltrust@127.0.0.1:5432/traveltrust
+          P3_CHAIN_OFF: "1"
+          CARGO_INCREMENTAL: "0"
+          GITHUB_RUN_ID: ${{ github.run_id }}
+          GITHUB_SHA: ${{ github.sha }}
+          PLAYWRIGHT_E2E_STEP_OUTCOME: ${{ steps.e2e_playwright.outcome }}
+        run: |
+          set -euo pipefail
+          export TRAVELTRUST_R002_REPORT_PARENT="${EVIDENCE_DIR}"
+          python3 scripts/gen-r002-iss007-prereport.py
+          RPT="${EVIDENCE_DIR}/r002_iss007_prereport/report.json"
+          test -f "${RPT}"
+          python3 scripts/validate-regression-report.py "${RPT}" \
+            --fail-on-no-go \
+            --fail-on-case-not-run
+      - name: Upload R-002 report + e2e evidence (production gate)
+        uses: actions/upload-artifact@v4
+        if: success()
+        with:
+          name: production-gate-e2e-r002-${{ github.run_id }}
+          path: |
+            evidence/GO_*/r002_iss007_prereport/report.json
+            evidence/GO_*/r002_iss007_prereport/*/notes.md
+          retention-days: 30
+
+  production-gate-summary:
+    name: Production gate (trinity) — gate closed
+    runs-on: ubuntu-latest
+    needs:
+      - verify-gate-config
+      - b421-doclink
+      - broadcast-all
+      - traveltrust-api-tests
+      - tier-96-15
+      - report-policy
+      - e2e-r002-93
+    steps:
+      - uses: actions/checkout@v6
+      - name: Write MANIFEST.json (evidence pointer)
+        env:
+          GITHUB_RUN_ID: ${{ github.run_id }}
+          GITHUB_SHA: ${{ github.sha }}
+          GITHUB_REF: ${{ github.ref }}
+          GITHUB_EVENT_NAME: ${{ github.event_name }}
+        run: |
+          set -euo pipefail
+          OUT="evidence/production-gate-${GITHUB_RUN_ID}"
+          TS="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
+          export OUT TS
+          python3 <<'PY'
+          import json, os
+
+          out = os.environ["OUT"]
+          os.makedirs(out, exist_ok=True)
+          d = {
+              "schema_version": "1",
+              "kind": "traveltrust.production_gate_manifest.v1",
+              "generated_at_utc": os.environ["TS"],
+              "workflow": "production-gate",
+              "github_run_id": os.environ["GITHUB_RUN_ID"],
+              "commit_sha": os.environ["GITHUB_SHA"],
+              "ref": os.environ["GITHUB_REF"],
+              "event": os.environ["GITHUB_EVENT_NAME"],
+              "gate_ssot": "gates/production_gate.yaml",
+              "jobs_required": [
+                  "verify-gate-config",
+                  "b421-doclink",
+                  "broadcast-all",
+                  "traveltrust-api-tests",
+                  "tier-96-15",
+                  "report-policy",
+                  "e2e-r002-93",
+              ],
+              "policy_doc": "docs/ci/CI-REQUIRED-PRODUCTION-GATE.md",
+              "notes": (
+                  "Enforcement: B-421 + broadcast + cargo test -p traveltrust-api + "
+                  "96-15 machine (or waiver) + PARTIAL_GO sunset on changed reports + "
+                  "Playwright (chromium, STRICT_SESSION_GATE, excludes @e2e-sepolia-deferred) + R-002 validate."
+              ),
+          }
+          path = os.path.join(out, "MANIFEST.json")
+          with open(path, "w", encoding="utf-8") as f:
+              json.dump(d, f, indent=2, ensure_ascii=False)
+          print("Wrote", path)
+          PY
+      - name: Upload production gate manifest
+        uses: actions/upload-artifact@v4
+        with:
+          name: production-gate-manifest-${{ github.run_id }}
+          path: evidence/production-gate-${{ github.run_id }}/MANIFEST.json
+          retention-days: 90
