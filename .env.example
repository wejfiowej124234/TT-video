# TravelTrust API 环境变量示例（见 08-5 §4、Runbook §10、04 §四、53 §3.9.8 BB2）
# 复制为 .env 后按需修改；.env 勿提交版本库。
# 多环境（BB2）：dev 本地、staging 预发、prod 生产；各环境 CORS_ORIGINS、DATABASE_URL、CHAIN_*、NEXT_PUBLIC_* 须分别配置；53 相关见 docs/spec/53-阶段开发技术文档.md §六附续 E2E 环境表与本节。

# SSOT 版本（08-3 约定）；STRICT_SSOT=1 时未设置则拒绝启动
SSOT_VERSION=unset

# 部署/升级前 SSOT hash（08-3 文件 sha256）。STRICT_SSOT=1 或 CHECK_SSOT=1 时必填。
# 获取方式（在仓库根）：sha256sum docs/spec/08-3-参数与门禁表.md | awk '{print $1}'
# SSOT_SHA256=

# 设为 1 时强制校验 SSOT_VERSION，未设置则拒绝启动
# STRICT_SSOT=1

# chargebackPolicy 的工程落点：Backend 运行时配置（用于法币路径拒付/争议处理的策略选择）。
# 未接法币时可保持 unset；若接法币，必须由法务按 08-3/Runbook 定稿后写死。
# CHARGEBACK_POLICY=

# --------- 120/140：GET /meta.build / GET /meta/build（发布证据与实例对齐；根级 build 与轻量路径同源）---------
# 进程或容器注入源码提交（完整或短 SHA 均可）；优先级高于编译期 TRAVELTRUST_BUILD_GIT_SHA。未设且编译期未注入时 /meta 返回 git_sha "unknown"。
# 运行时发布追溯：须与发布 tag 所指 commit 一致（例 git rev-parse v0.1.0）；容器/进程注入
# TRAVELTRUST_GIT_SHA=
# 兼容别名（云平台常用）：
# GIT_COMMIT_SHA=
# SOURCE_VERSION=
# 镜像构建时在 cargo build 前 export，写入二进制兜底（与运行时变量二选一或叠加，运行时优先）：
# TRAVELTRUST_BUILD_GIT_SHA=
# 本次部署时间戳，建议 UTC ISO8601（可与 140 发布记录 deployed_at 一致）；未设则 JSON null。
# TRAVELTRUST_DEPLOYED_AT=
# DEPLOYED_AT=

# 监听端口（默认 8080；必须与前端请求一致，勿设为 3012，否则登录等请求会失败）
# PORT=8080

# 生产环境必设：允许的 CORS origin，逗号分隔。未设时开发态默认允许 http://localhost:3012 与 3000。
# 生产必配（P4）：生产环境必须设置，否则跨域请求被浏览器拦截；若未设且非 STRICT_SSOT 则 very_permissive。
# 若手动设置，本地前端 3012 须包含：CORS_ORIGINS=http://localhost:3012,http://localhost:3000
# 示例：CORS_ORIGINS=https://app.example.com,https://dapp.example.com
# CORS_ORIGINS=
# 注意：与 **STRICT_SSOT=1** 或 **CHECK_SSOT=1** 联用时，**必须**设置非空 CORS_ORIGINS，否则启动拒绝（见 crates/api startup）。

# --------- Pause 门禁（PAUSE_MODE=1 时仅白名单接口可用）---------
# 未设置 **PAUSE_API_ALLOWLIST** 时默认：`GET /health;GET /meta;GET /meta/build;GET /api/v1/media/access/*`（**688** 轻量 **`build`** 与 **GET /meta** · **`build`** 同源；末项为 **270** 短期签名 URL 兑现，与 `crates/api` pause_gate_layer 一致）
# PAUSE_MODE=1
# PAUSE_API_ALLOWLIST=GET /health;GET /meta;GET /meta/build;GET /api/v1/media/access/*

# --------- 幂等键（01 §10 #14、04 §四、crates/api 中间件 idempotency）---------
# 生产建议开启：写操作须带 Idempotency-Key 或 X-Idempotency-Key（UUID 或客户端稳定 token），重复提交返回首次响应。
# REQUIRE_IDEMPOTENCY_KEY=1
# 进程内内存幂等条数上限（1～1000000，默认 1000）；高并发可调大；与 idempotency_keys 表并存时 DB 仍跨重启复用。
# IDEMPOTENCY_CACHE_MAX=10000
# 实现落点：路由层去重与结果缓存；与 x-message-id 配合见 04 §四、缺口与待补-官方总表 P1-A messageId 行。

# --------- API 鉴权门禁（P1：缺口总表 P1-A 鉴权与 SQLx）---------
# 设为 1 时：非公开 /api/v1 路由须带 **Authorization: Bearer <session_token>**，**不接受**仅 X-User-Id（防联调绕过）。生产建议评估开启。
# 有 DATABASE_URL 时，登录/注册返回的不透明会话为 **tts_<uuid>**；前端存入 traveltrust_session_token 并随请求发送；伪造 Bearer 不再回退到 X-User-Id（见 crates/api state::extract_user_with_session_check）。
# STRICT_SESSION_GATE=1

# --------- 内网 internal API（04 §7.6、网关须封禁公网访问 /api/v1/internal/*）---------
# 设为非空时：所有 **`/api/v1/internal/*`** 请求须带头 **`X-Internal-Api-Secret: <同值>`**，否则 **403** **`internal_api_forbidden`**（与前端 `parseResponse` 一致）。
# 未设或留空：不校验（本地 cron/联调）；**预发/生产建议与 VPC/防火墙叠加使用**。
# INTERNAL_API_SECRET=

# --------- 业务数据持久化（01 §3、04 §四 用户等相关数据落库） ---------
# 设置后 API 将用户/向导/订单/争议等写入 PostgreSQL；未设则使用内存 Store，重启清空。见 04-附录-DDL草案 §9。
# 本地 Docker Postgres（项目根执行 docker compose up -d 后，复制下面一行到 .env 并取消注释）：
# DATABASE_URL=postgres://traveltrust:traveltrust@localhost:5432/traveltrust
# 自建库示例：# DATABASE_URL=postgres://user:pass@localhost:5432/traveltrust

# --------- 270：媒体短期签名 URL（04 §3.4、crates/api/src/routes/media.rs）---------
# POST /api/v1/media/signed-urls 返回的 url 基址（浏览器/客户端须能访问到该主机上的 API）；缺省 http://127.0.0.1:$PORT
# PUBLIC_API_BASE_URL=http://localhost:8080
# 别名（与 PUBLIC_API_BASE_URL 二选一）
# API_PUBLIC_BASE_URL=

# --------- 档期持久化（49 C，可选） ---------
# 设置后 schedule_engine 档期将落盘到该 JSON 文件，重启后自动加载；未设则档期仅内存，重启清空。见 ops/RUNBOOK §2.5。
# SCHEDULE_SLOTS_PATH=data/schedule_slots.json

# --------- 开发用测试账号（可选） ---------
# 设为 1 时 API 会创建测试账号并允许前端调用 /auth/seed-test-accounts；未设则登录页会 403/401。
# 游客：tourist@test.com / 向导：guide@test.com，密码均为 Test123!
# 本地联调建议：取消下一行注释，或直接运行 scripts\start-api-with-seed.bat（会设置该变量）。
# SEED_TEST_ACCOUNTS=1

# --------- 84 文档镜像 · 待生效参数包（04 §3.4、GET …/protocol-reference/pending、B-074） ---------
# 可选：JSON 对象，与 GET /api/v1/governance/protocol-reference 成功体**深度合并**（典型只覆写 fee_router 子树）；未设或空则待生效包与当前镜像一致（响应根级 pending_package_source=mirror）。
# 示例（国家桶 45→44）：PROTOCOL_REFERENCE_PENDING_OVERLAY={"fee_router":{"layer1_percent_of_allocatable_platform_fee":{"country_bucket":44}}}
# PROTOCOL_REFERENCE_PENDING_OVERLAY=

# --------- 49 F：payment_window 与防锁单（80 §4.9、§4.15） ---------
# 接单后须在 N 分钟内 deposit，超时自动取消并释放档期。优先读 PAYMENT_WINDOW_MINUTES（分钟），未设则用 P3_PAYMENT_TTL_SECS（秒）。建议 30。
# PAYMENT_WINDOW_MINUTES=30
# P3_PAYMENT_TTL_SECS=1800
# 防锁单：每用户每小时 confirm 次数上限（可选；未实现时忽略）
# CONFIRM_RATE_LIMIT_PER_USER=10

# --------- P3 链下模式（仅控制 mock-pay） ---------
# 混合架构：注册/登录/向导/订单等业务 API 始终可用（无需本变量）。P3_CHAIN_OFF=1 时额外开放 POST /api/v1/orders/:id/mock-pay（Accepted→Escrowed 模拟），仅用于本地联调；**本地链+模拟代币+合约时不需要 mock**，直接走真实链上流程测试。
# P3_CHAIN_OFF=1

# --------- P5 链上模式（01 §8、09、27-P5） ---------
# 设置后启用 chain 模块与执行器 outbox；未设则链下模式。
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# CHAIN_ID=137
# 与 API **`ChainOffConfig.business_chain_id`** / **`orders.chain_id`** 双写一致（可空列；纯链下未配 CHAIN_RPC_URL 时不落库）
# ESCROW_FACTORY_ADDRESS=0x...
# STAKING_ADDRESS=0x...
# REGISTRY_ADDRESS=0x...
# FeeRouter（83/84、14 §1.1、07 §五 5.2A）：设后 indexer-tick 额外 eth_getLogs 该地址并索引 PlatformFeeRouted；有 DATABASE_URL 时落库 fee_router_routed_events
# 生产/预发：须与 Escrow 实例的 platformFeeRecipient（创建时写入）及前端 NEXT_PUBLIC_FEE_ROUTER_ADDRESS、GET /meta 中 fee_router_address 一致
# FEE_ROUTER_ADDRESS=0x...
# RegionVault（14 §1.1.1、110）：设后 indexer-tick 额外 eth_getLogs 该地址并索引 RegionVaultForwarded；有 DATABASE_URL 时落库 region_vault_forwarded_events
# REGION_VAULT_ADDRESS=0x...
# TravelTrustGovernor（B-089 Completion）：设后 indexer-tick eth_getLogs 该地址；DATABASE_URL 时写入 event_log 并投影 governance_proposals_projection；GET /governance/proposals 走链上模式（须跑 migration 20260207120000）
# GOVERNOR_ADDRESS=0x...
# 与 Governor 绑定的 GovernanceVotesToken：GET …/governance/proposals/:id 可选 eth_call getPastVotes(default_wallet, snapshot_block)
# GOVERNANCE_VOTES_TOKEN_ADDRESS=0x...
# 份额代币（TTG / Country Pool 等）ERC20：逗号分隔；设后 indexer-tick 对该批地址 eth_getLogs Transfer(topic0) 并写入 investor_share_transfer_events（B-085）
# INVESTOR_SHARE_TOKEN_ADDRESSES=0x...,0x...
# InvestorShareLockLedger 等锁仓合约：逗号分隔；设后 indexer-tick eth_getLogs Locked|Unlocked 写入 investor_lock_state_events；应计在质押叠加之后再叠锁仓 overlay（B-088 · TT 112）
# INVESTOR_LOCK_CONTRACT_ADDRESSES=0x...
# 执行器代发 executeResolution 时使用的私钥（hex 32 字节，0x 可选）；未设则 process-resolution-outbox 发 tx 报错。
# CHAIN_EXECUTOR_PRIVATE_KEY=
# 01 §7 P0 单笔/单日额度（可选）：单笔总金额上限、单日累计上限；0 或不设表示不限制
# CHAIN_EXECUTOR_MAX_AMOUNT_PER_TX=0
# CHAIN_EXECUTOR_MAX_AMOUNT_PER_DAY=0
# 执行器发 tx 失败重试次数（04 §五、01 §9）
# CHAIN_EXECUTOR_RETRY_COUNT=3
# 索引器 indexer-tick：仅拉取至 chain_tip − max(1, FINALITY_N) 的块（110 §3.3）；默认 12（与前端 finality 文案一致）
# FINALITY_N=12
# 已配置 CHAIN_RPC_URL + ESCROW_FACTORY_ADDRESS 时：可选下限闸，防 FINALITY_N 误配过低抢跑（110 §3.3、04 §四、startup enforce_indexer_finality_floor）
# INDEXER_MIN_FINALITY_N=12
# 同上场景：=1 且未设 INDEXER_MIN_FINALITY_N 时，要求 FINALITY_N ≥ 12
# STRICT_INDEXER_FINALITY=1

# DID 排行榜向导榜（sort=reviews / sort=weighted）：信誉轨最低窗口内完成单数，默认 3，范围 1～50
# DID_RANK_GUIDE_MIN_COMPLETED_FOR_REPUTATION_SORTS=3
# 加权排序权重（须成对设置；0～1，运行时按和归一；未同时设置则 0.6/0.4）
# DID_RANK_GUIDE_WEIGHTED_W_ACTIVITY=0.6
# DID_RANK_GUIDE_WEIGHTED_W_REPUTATION=0.4
# 内网 scheduler/run-next 执行社区排序快照任务时，每模式抓取条数（1～100，默认 30；04 内部 API、160/421）
# COMMUNITY_RANKING_SNAPSHOT_LIMIT=30

# --------- 向导注册可选校验（企业级审计 I3、C3） ---------
# VALIDATE_EIP55=1 时向导 wallet_address 必须通过 EIP-55 校验和（防笔误）
# REQUIRE_ID_PHOTO=1 时向导申请必须上传护照照片（id_photo_url 必填）
# VALIDATE_EIP55=1
# REQUIRE_ID_PHOTO=1

# --------- 证据 API 限流（08-3、27-P30、01 §6 DoS P0） ---------
# 每 (order_id, user_id) 每分钟证据提交次数上限；0 或不设表示不限制。定稿值 60（08-3 变更记录 2025-02-27）。
# 证据双写：=1 时 DB 插入失败返回 503（不写入 chain_off 内存），生产对账推荐（Phase 5 / Runbook §9）
# TRAVELTRUST_STRICT_EVIDENCE_DB_WRITE=0
# 订单聊天双写：=1 时 DB 插入失败返回 503（不写内存）
# TRAVELTRUST_STRICT_MESSAGE_DB_WRITE=0
# 评价双写：=1 时 DB 插入失败返回 503（不写内存）；迁移 ux_reviews_order_id_reviewer_id 须已应用
# TRAVELTRUST_STRICT_REVIEW_DB_WRITE=0
# 链下发起争议：=1 时 disputes 表 insert 失败则回滚订单状态与内存争议并返回 503（订单行会尽力写回前一状态）
# TRAVELTRUST_STRICT_DISPUTE_OPEN_DB_WRITE=0
# 仲裁裁决落库：=1 时订单 upsert 或 update_dispute_resolved 失败则回滚内存并尽力把订单行写回裁决前状态 → 503
# TRAVELTRUST_STRICT_DISPUTE_RESOLVE_DB_WRITE=0
# 行程双写（确认最终版 snapshot_hash、PATCH 写回 days/version）：=1 时 DB 更新失败回滚内存并 503
# TRAVELTRUST_STRICT_ITINERARY_DB_WRITE=0
# 订单行 upsert：=1 时 accept/cancel/mock pay/完成/双边确认/评分确认/开争议前 persist 等失败回滚内存并 503
# TRAVELTRUST_STRICT_ORDER_DB_WRITE=0
# 注册/登录会话落库：=1 时 insert_user/insert_session 失败回滚内存并 503
# TRAVELTRUST_STRICT_AUTH_DB_WRITE=0
# SEED_TEST_ACCOUNTS 测试账号：=1 时须先 DB 成功再写入内存；失败则跳过该账号（见 GET /meta seed_test_accounts）
# TRAVELTRUST_STRICT_SEED_DB_WRITE=0
# 向导注册 insert_guide：=1 时失败从内存移除并 503 guide_db_persist_failed
# TRAVELTRUST_STRICT_GUIDE_DB_WRITE=0
# 50-O-R1 / Runbook §9：运维声明的链下 DB 双写失败处置档位（观测用；与 GET /meta.dual_write、startup_snapshot 同源）
# 合法值（大小写不敏感）：log_only 或 1（① 默认）；strict_503 / fail_closed 或 2（② 须配合上列各 TRAVELTRUST_STRICT_*_DB_WRITE=1 分路径 503）；alert_only 或 3（③ 外接告警、HTTP 不变）。非法或空 → log_only。
# DUAL_WRITE_FAILURE_POLICY=log_only
# EVIDENCE_MAX_REQUESTS_PER_MINUTE=60
# 评价防刷（Phase 5 / 07）：每 (order_id, reviewer) 每分钟提交上限；0=不启用（默认）
# REVIEW_MAX_REQUESTS_PER_MINUTE=0
# 低分（≤2）评论最短字符；0=不校验
# REVIEW_LOW_SCORE_COMMENT_MIN_CHARS=20

# --------- 证据时间戳策略与链下回执（startup、routes/evidence；04 §三、缺口表 P1 证据 API） ---------
# 策略：backend_signed（默认）等；与代码 state::EvidenceTimeState 一致，详见 startup 日志 startup_snapshot 行。
# EVIDENCE_TIMESTAMP_POLICY=backend_signed
# 无 chain_off 时 POST 证据可走 backend_signed + HMAC 回执；生产须设强随机密钥（勿提交版本库）。
# EVIDENCE_RECEIPT_HMAC_KEY=
# 单调时钟/上次提交时间状态文件路径（默认 data/evidence_time_state.json）。
# EVIDENCE_TIME_STATE_PATH=data/evidence_time_state.json

# --------- Admin 对账导出 Ed25519（可选；200 / GET /meta.admin_exports） ---------
# 32 字节种子 hex（64 字符）。设置后 GET …/admin/indexer/reconcile-reports/export 对响应体字节签名，头 x-traveltrust-reconcile-export-ed25519；公钥见 GET /meta。
# RECONCILE_EXPORT_ED25519_SEED_HEX=

# --------- Indexer tick 可选自动 reorg（110 Partial；须 DATABASE_URL） ---------
# 设为 1 时：单轮 indexer-tick 在检测到 reorg_suspected 后至多自动执行一次与 indexer-reorg-rewind 同源的删尾+replay，成功响应可含 reorg_auto_rewind；仍不一致则 503 reorg_still_suspected_after_auto_rewind。不替代 Runbook 与 orders/chain_off 内存人工核对。
# INDEXER_REORG_AUTO_REWIND_ON_TICK=0

# tick 内补充 eth_getLogs（已关联 escrow 实例列表 / FEE_ROUTER_ADDRESS / REGION_VAULT_ADDRESS）：默认 RPC 失败仍 200，响应体含 logs_fetch_skipped（scope + error 等）。设为 1 时任一分支失败则整 tick 500 fetch_supplemental_logs_failed。
# INDEXER_STRICT_SUPPLEMENTAL_LOG_FETCH=0

# reorg-rewind / tick 自动回滚成功后：默认将 chain_off 内存 orders + guide_slot 与 orders 表对齐（list_orders）；仅内存且未落库订单保留。设为 0 跳过（大库/排障）；不设或非 0 即启用。
# INDEXER_REORG_RELOAD_CHAIN_OFF_ORDERS_AFTER_REWIND=0

# replay 后可选：将 orders 与重建后的 orders_projection 对齐（候选 = 已填 escrow 的订单 ∪ 本链投影中出现的 order_id）。无投影且已填 escrow：status=escrowed → accepted 并清 escrow（demoted_escrowed_no_projection）；status 为 draft/created/accepted → 清 escrow 列、保持状态（cleared_orphan_escrow_pre_funded）；completed/disputed/refunded/partially_refunded/slashed/cancelled 等终态 → 默认仅计入 skipped_no_projection_non_escrowed_with_escrow；另设下面为 1 时与 pre_funded 同路径清 escrow 列、保持 status（cleared_orphan_escrow_terminal_no_projection）。响应 orders_table_projection_sync 含上列计数等（110 §3.1.3 Partial，默认关）。
# INDEXER_REORG_SYNC_ORDERS_FROM_PROJECTION_AFTER_REWIND=1
# 须与上一行同时为 1 方生效：终态无投影时也自动清孤立 escrow_address（运维确认后启用）。
# INDEXER_REORG_SYNC_CLEAR_ORPHAN_ESCROW_TERMINAL=0

# --------- 链级 orders 删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 双闸） ---------
# 设为 1（trim）且 POST …/internal/indexer-reconcile 的 JSON 同时含 orders_chain_scope_rollback_execute:true 与 orders_chain_scope_rollback_confirm:"CONFIRM_DELETE_ORDERS_CHAIN_<chain_id>"（与 body chain_id 或 CHAIN_ID 默认一致）时，对账 200 后事务删除该链的 orders（仅 chain_id 匹配）与 orders_projection 及 evidence_receipts/disputes/reviews 等阻塞 FK 行；不设或非 1 时 **403** orders_chain_scope_rollback_execute_forbidden。**不**删 chain_id IS NULL 或其它链订单；**不**删 event_log。生产须 01/03 评审。
# TRAVELTRUST_ALLOW_ORDERS_CHAIN_SCOPE_ROLLBACK=0

# --------- 链级 event_log / checkpoint / FeeRouter 投影删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 独立双闸） ---------
# 设为 1 且 JSON 含 event_log_chain_scope_rollback_execute:true 与 event_log_chain_scope_rollback_confirm:"CONFIRM_DELETE_EVENT_LOG_CHAIN_<chain_id>" 时，对账 200 后事务删该链 event_log、checkpoints_sharded、fee_router_routed_events；不设或非 1 时 **403** event_log_chain_scope_rollback_execute_forbidden。**不**改进程内 indexer 内存进度（须重启或自行对齐 tick/replay）。与上一段 orders 回滚 ENV 独立。
# TRAVELTRUST_ALLOW_EVENT_LOG_CHAIN_SCOPE_ROLLBACK=0

# --------- 链级 correction_log / executor_executions 删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 独立双闸） ---------
# 设为 1 且 JSON 含 correction_executor_chain_scope_rollback_execute:true 与 correction_executor_chain_scope_rollback_confirm:"CONFIRM_DELETE_CORRECTION_EXECUTOR_CHAIN_<chain_id>" 时，对账 200 后事务删该链两表行；不设或非 1 时 **403** correction_executor_chain_scope_rollback_execute_forbidden。与 orders/event_log 回滚 ENV 独立。
# TRAVELTRUST_ALLOW_CORRECTION_EXECUTOR_CHAIN_SCOPE_ROLLBACK=0

# --------- 进程内 indexer 与 DB checkpoint 对齐（110 §3.1.4 Partial） ---------
# 设为 1 且 POST …/internal/indexer-reconcile JSON 含 sync_indexer_memory_from_db_checkpoint:true 时，对账 200 后按 checkpoints_sharded（traveltrust_indexer_tick_v1）重写进程内 last_block/last_log_index、裁剪内存 events、落盘 INDEXER_STATE_PATH.runtime；无 DB 行时等价归零。**403** indexer_memory_sync_from_db_forbidden。GET /meta.indexer.memory 即读进程内态；GET /meta.indexer.checkpoint 仍可能为启动快照直至重启。
# TRAVELTRUST_ALLOW_INDEXER_MEMORY_SYNC_FROM_DB=0

# --------- Outbox / 执行器（48、Runbook；CHAIN_* 已设时启用 worker） ---------
# 待发送链上事件目录；/meta 与 intents 等读取。
# OUTBOX_DIR=data/outbox
# 设为 1 时启动后台 outbox worker（见 startup）。
# OUTBOX_WORKER=0
# OUTBOX_LEASE_SECS=60
# OUTBOX_POLL_MS=500
# OUTBOX_MAX_ATTEMPTS=10

# --------- 关键写接口限流（55 G7、53 附录 A BB5、Runbook §1） ---------
# accept、confirm-bilateral、confirm-rating、confirm-final-plan、cancel、reviews 按 IP 每分钟上限；0 表示不限制。默认 15。
# CRITICAL_WRITE_RATE_LIMIT_PER_MINUTE=15

# --------- 前端构建用（frontend/ Next.js） ---------
# API 基地址，构建时注入（见 05 §四；frontend 使用 NEXT_PUBLIC_API_BASE_URL）
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 与 CHAIN_ID / wagmi 目标链一致（默认 137）；自定义链时配合 NEXT_PUBLIC_RPC_URL
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_RPC_URL=
# 部署的 Registry 合约（方案 B）；未设时质押页不展示链上资格只读块
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...
# 部署的 Staking 合约；未设时质押页不展示链上质押余额只读块
# NEXT_PUBLIC_STAKING_ADDRESS=0x...
# WalletConnect v2（可选）
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
