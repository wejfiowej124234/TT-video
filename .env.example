# TravelTrust API 环境变量示例（见 08-5 §4、Runbook §10、04 §四）
# 复制为 .env 后按需修改；.env 勿提交版本库。

# SSOT 版本（08-3 约定）；STRICT_SSOT=1 时未设置则拒绝启动
SSOT_VERSION=unset

# 部署/升级前 SSOT hash（08-3 文件 sha256）。STRICT_SSOT=1 或 CHECK_SSOT=1 时必填。
# 获取方式（在仓库根）：sha256sum docs/spec/08-3-参数与门禁表.md | awk '{print $1}'
# SSOT_SHA256=

# 设为 1 时强制校验 SSOT_VERSION，未设置则拒绝启动
# STRICT_SSOT=1

# chargebackPolicy 的工程落点：Backend 运行时配置（用于法币路径拒付/争议处理的策略选择）。
# 未接法币时可保持 unset；若接法币，必须由法务按 08-3/Runbook 定稿后写死。
# CHARGEBACK_POLICY=

# 监听端口（默认 8080，与 frontend 默认 NEXT_PUBLIC_API_BASE_URL 一致）
# PORT=8080

# 生产环境必设：允许的 CORS origin，逗号分隔（未设则开发态允许任意，存在 CSRF 风险）
# 示例：CORS_ORIGINS=https://app.example.com,https://dapp.example.com
# CORS_ORIGINS=

# --------- 前端构建用（frontend/ Next.js） ---------
# API 基地址，构建时注入（见 05 §四；frontend 使用 NEXT_PUBLIC_API_BASE_URL）
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
