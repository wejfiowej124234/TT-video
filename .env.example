# INDEXER_MIN_FINALITY_N=12
# 同上场景：=1 且未设 INDEXER_MIN_FINALITY_N 时，要求 FINALITY_N ≥ 12
# STRICT_INDEXER_FINALITY=1

# --------- TT-B435 / Foundry：`forge script --broadcast` · `cast send`（§3.0 / §3.1 / §3.3）---------
# 与 `GovernanceTimelock.admin()` 对齐的 EOA 私钥；**勿提交**；单行、**无引号**；推荐 **`0x` + 64 个 hex**，或 **64 个 hex 不带 `0x`**（质押脚本会归一化）。
# 根目录 `.env` 须含 **`PRIVATE_KEY=`** 一行，否则 `scripts/ops/b435-sepolia-stake-first-payment.example.sh` 与 `cast wallet address` 门禁会报 `len=0` / decode 失败。
# PRIVATE_KEY=

# --------- TT-B407：`scripts/ops/b407-exec-chain-release-distribute.sh`（release / distribute）---------
# 须与上 **`CHAIN_RPC_URL`**、**`FEE_ROUTER_ADDRESS`**（Escrow **`platformFeeRecipient`** 同址）及**已 Funded** 的 Escrow 实例一致。
# 预检（不打印私钥）：`bash scripts/ops/b407-env-preflight.example.sh`；**`B407_PREFLIGHT_MODE=release`** 只校验 relayer；**`distribute`** 只校验 owner。
# B407_ESCROW=0x...   # 与 TT-B407 同源别名：B407_ESCROW_ADDRESS（二选一）
# B407_ESCROW_ADDRESS=0x...
# B407_RELAYER_PK=0x...   # 单行、无引号、无 CRLF；**`0x` + 64 hex**（或 64 hex 无 `0x`）
# B407_OWNER_PK=0x...     # 仅 **`distribute`** 需要；**`B407_SKIP_DISTRIBUTE=1`**（仅 release）时可不设

# --------- TT-B417：Sepolia 链上治理 queue/execute（scripts/ops/b417-governance-execution-automation.sh · B417_CHAIN_MODE=1）---------
# 与 API 是否 P5 无关；须 Foundry cast、有 Sepolia ETH 的 EOA。提案 state 须 Succeeded(4) 再 queue；Queued(5) 且 Timelock delay 届满再 execute（脚本会等待）。
# 缺什么补什么：GOVERNOR_ADDRESS / GOVERNANCE_TOKEN_ADDRESS / B417_PROPOSAL_ID / 私钥 须来自你的 Sepolia 部署与钱包；仅有 RPC+Governor 时可枚举 state 辅助选题案 ID：
#   bash scripts/ops/b417-list-proposal-states.sh
# 新部署 Governor 常 proposalCount=0，此时 list 无 state=4 行属正常。首个提案闭环：bash scripts/ops/b417-sepolia-propose-vote-succeeded.sh
# 本仓库 GovernanceVotesToken 无 delegate()（余额 checkpoint 即投票权）；外链 ERC20Votes 才需 B417_DELEGATE_CAST=1 或 script/SepoliaDelegateSelf.s.sol
# 已 queue（state=5）同提案一键复跑 execute/证据：B417_ALLOW_QUEUED_PREFLIGHT=1；可选 B417_QUEUE_TX_HASH=0x…（无则须 B417_RECORD_DIR 内已有 b417-chain-step-queue.json）
# 填好后先跑：bash scripts/ops/b417-env-gap-check.sh（企业缺口扫描）→ bash scripts/ops/b417-sepolia-preflight.sh（主脚本在 B417_CHAIN_MODE=1 时也会默认先跑，可用 B417_SKIP_PREFLIGHT=1 跳过）
# 链上跑完后归档核验：bash scripts/ops/b417-evidence-pack-verify.sh "$B417_RECORD_DIR"
# CHAIN_ID=11155111
# CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com  # API SSOT；勿用 RPC_URL 别名
# GOVERNOR_ADDRESS=0x…
# B417_PROPOSAL_ID=…
# B417_PRIVATE_KEY=0x…  或 B417_GOV_EXEC_PK=（二选一；勿提交版本库）

# DID 排行榜向导榜（sort=reviews / sort=weighted）：信誉轨最低窗口内完成单数，默认 3，范围 1～50
# DID_RANK_GUIDE_MIN_COMPLETED_FOR_REPUTATION_SORTS=3
# 加权排序权重（须成对设置；0～1，运行时按和归一；未同时设置则 0.6/0.4）
# DID_RANK_GUIDE_WEIGHTED_W_ACTIVITY=0.6
# DID_RANK_GUIDE_WEIGHTED_W_REPUTATION=0.4
# 内网 scheduler/run-next 执行社区排序快照任务时，每模式抓取条数（1～100，默认 30；04 内部 API、160/421）
# COMMUNITY_RANKING_SNAPSHOT_LIMIT=30
#
# 社区发帖 **`POST /api/v1/community/posts/upload-media`**：解码后单文件字节上限（默认 524288=512KiB；最大 980000，须低于全站 **`REQUEST_BODY_LIMIT_BYTES`** 约 1MiB 的 JSON 体）。
# TRAVELTRUST_COMMUNITY_POST_MEDIA_MAX_DECODED_BYTES=
#
# 前端发帖弹窗预检须与上项同值（**Next 构建期**注入；调后端上限后请同步并 **rebuild frontend**）。
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_MAX_DECODED_BYTES=524288
#
# 社区发帖 **MP4** 视频时长上限（秒；默认 180；**1～3600**；与 **`routes/community/media_upload`** **`moov/mvhd`** 校验同源）。
# TRAVELTRUST_COMMUNITY_POST_MEDIA_MAX_VIDEO_DURATION_SEC=
#
# 前端视频时长预检须与上项同值（**Next 构建期**；**`sync-frontend-env-local-from-root.*`** 可从根 `.env` 同步）。
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_MAX_VIDEO_DURATION_SEC=180
#
# **②③** 发帖 / 市场子站 **`payload`** 内嵌 **`http(s)://`** 外链护栏（与 **`crates/api/src/routes/community/common/embedded_http_urls.rs`**、`market_subsite` 同源）：
# - 非空时：字符串须以**逗号分隔**列表中某一前缀开头（CDN/自家 API 域等）。
# TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=https://cdn.example.com,https://api.example.com
# - =1 时禁止内嵌 **`http://`**（仅 **https://**）。
# TRAVELTRUST_PRODUCTION_SAFE_DEFAULTS=1
#
# 前端发帖弹窗 **`cover_url`** 预检（**Next 构建期**；与上两项同源，可不设则仅走后端 **400**）：
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES=https://cdn.example.com,https://api.example.com
# NEXT_PUBLIC_TRAVELTRUST_PRODUCTION_SAFE_DEFAULTS=1
# 一键同步：`scripts/dev/sync-frontend-env-local-from-root.*` 会将根 **`TRAVELTRUST_*`** 写入 **`frontend/.env.local`** 对应 **`NEXT_PUBLIC_*`**。

# --------- 社区视频 Phase1：S3 multipart（`community_media_assets`；Runbook **`docs/runbook/COMMUNITY-MEDIA-OBJECT-STORAGE.md`**） ---------
# 须在**后端根 `.env`（由 `traveltrust-api` 进程加载）**配置 **`COMMUNITY_MEDIA_S3_BUCKET`**、**`COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL`**、**S3/R2 凭据**（与 **`aws_config` 默认链**一致，例如 **`AWS_ACCESS_KEY_ID`** / **`AWS_SECRET_ACCESS_KEY`**；R2 常配 **`COMMUNITY_MEDIA_S3_ENDPOINT`** + **`COMMUNITY_MEDIA_S3_REGION=auto`**）及**桶 CORS**（允许站点来源 **`PUT`**、**`ExposeHeader: ETag`** 等，见 Runbook §CORS）；**改后须重启 Rust API**，否则进程仍按旧环境运行。
# 未配齐或 **HeadBucket** 失败时：**`GET /api/v1/community/media/capabilities`** 返回 **`public_video_publish_ready=false`**（**`status`** 可为 **`degraded`**），前端须隐藏/禁用「正常视频」发布并提示对象存储未启用；**`POST …/upload-media`** **不再接受** **MP4/WebM** Base64（须走 multipart）。若 **`TRAVELTRUST_COMMUNITY_PUBLIC_VIDEO_SPEC_REQUIRED=1`**：**`GET /health`** 在未就绪时 **503**；**`scripts/dev/preflight-local-stack.ps1`** 会校验桶与公网基址已填（不代替线上 CORS/凭据验收，见 Runbook）。
# COMMUNITY_MEDIA_S3_BUCKET=
# COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=https://cdn.example.com
# 前端 Feed `<video>` 同源代理（与 next.config `/tt-community-s3/*` rewrite 对齐）；本地 MinIO 证据链须与后端同值。
# NEXT_PUBLIC_COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL=http://127.0.0.1:19000/traveltrust-community-media
# COMMUNITY_MEDIA_S3_ENDPOINT=
# COMMUNITY_MEDIA_S3_REGION=us-east-1
# COMMUNITY_MEDIA_S3_FORCE_PATH_STYLE=0
# COMMUNITY_MEDIA_S3_KEY_PREFIX=community-media/v1
# COMMUNITY_MEDIA_PRESIGN_TTL_SEC=900
# 可选：**stderr** 单行审计（**`GET /health`** 社区视频规格闸 + **`GET …/media/capabilities`** 能力快照 + **multipart** 链；标记 **`tt_community_multipart_chain=release_multipart_chain_v1`**，与响应头 **`x-request-id`** 对拍；见 Runbook 环境表 **`TT_COMMUNITY_MULTIPART_LOG`** 与 **`local-release-ready-vs-testnet.md`**）。**1** / **true** / **yes** 开启；默认不设即关。
# TT_COMMUNITY_MULTIPART_LOG=0
# =1/true：声明「正式社区视频规格」已启用；**`GET /health`** 须 **S3/R2 HeadBucket** 通过，否则 **503**（与 **`public_video_publish_ready`** 同源）；**`preflight-local-stack.ps1`** 校验 **`COMMUNITY_MEDIA_S3_*`** 基址非空。本地默认不设，免挡 **`wait-for-api`**。
# TRAVELTRUST_COMMUNITY_PUBLIC_VIDEO_SPEC_REQUIRED=0
# 单对象字节上限（**5MiB～1GiB** 钳位；默认约 **500MiB** = **524288000**；与 **`crates/api/src/storage/community_media_s3.rs`** **`max_asset_bytes`** 同源）。
# TRAVELTRUST_COMMUNITY_MEDIA_ASSET_MAX_BYTES=524288000
# 默认分片大小（**≥5MiB**；默认 **8MiB** = **8388608**）。
# TRAVELTRUST_COMMUNITY_MEDIA_PART_SIZE_BYTES=8388608
#
# 前端 **`PublishDrawer`** 选视频体积预检（**Next 构建期**；须与 **`TRAVELTRUST_COMMUNITY_MEDIA_ASSET_MAX_BYTES`** 同值，否则客户端上限与 API 不一致）。不设则回退默认 **500MiB**。`scripts/dev/sync-frontend-env-local-from-root.*` 可从根 `.env` 写入 **`frontend/.env.local`**。
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_MEDIA_ASSET_MAX_BYTES=524288000
#
# **打通 multipart 发帖**：若配置了 **`COMMUNITY_MEDIA_S3_PUBLIC_BASE_URL`**，请把同一 CDN/公网基址（或更长前缀）并入 **`TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES`** 与 **`NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_POST_MEDIA_URL_PREFIXES`**，否则后端 **400** `media_url_prefix_not_allowed`；前端在带 **`media_asset_id`** 时已跳过外链前缀预检，但服务端仍会校验。

# --------- TT 社区「我的」前端开关（`frontend/lib/communityMeFeatureFlags.ts`；①②③ 同键，测试网/生产按需显式开启） ---------
# 个人中心头像本机上传（`POST …/me/profile-avatar`）：**production** 默认关；测试网或生产若要开，在 **`frontend/.env.production.local`** 或构建环境设 **`1`**。
# NEXT_PUBLIC_COMMUNITY_ME_AVATAR_UPLOAD=1
# 赞过列表与「帖子获赞」统计（`GET …/community/me/likes` 等）：默认开；显式 **`0`**/`false` 关闭。
# NEXT_PUBLIC_COMMUNITY_ME_LIKES_LIST=1
# 「不在本机展示获赞总数」为用户浏览器 **localStorage**（非 env；键 **`traveltrust_community_hide_likes_received_metric_v1`**，`frontend/lib/communityMeLikesMetricPrivacy.ts`）；①②③ 与构建环境无关；隐藏时 **`useCommunityMeLikesReceivedCachePurgeOnHide`** 清 **`communityMeLikesReceivedQueryKey`**（含跨标签）。
# 个人简介 bio 预览区（须 **`PUT /me` `bio`** 等后端契约落地后才可持久化；**production** 另须 **`NEXT_PUBLIC_COMMUNITY_ME_BIO_ALLOW_PRODUCTION=1`**）。
# NEXT_PUBLIC_COMMUNITY_ME_BIO=1
# NEXT_PUBLIC_COMMUNITY_ME_BIO_ALLOW_PRODUCTION=1

# --------- 向导注册可选校验（企业级审计 I3、C3） ---------
# VALIDATE_EIP55=1 时向导 wallet_address 必须通过 EIP-55 校验和（防笔误）
# REQUIRE_ID_PHOTO=1 时向导申请必须上传护照照片（id_photo_url 必填）
# VALIDATE_EIP55=1
# REQUIRE_ID_PHOTO=1

# --------- 证据 API 限流（08-3、27-P30、01 §6 DoS P0） ---------
# 每 (order_id, user_id) 每分钟证据提交次数上限；0 或不设表示不限制。定稿值 60（08-3 变更记录 2025-02-27）。
# 证据双写：=1 时 DB 插入失败返回 503（不写入 chain_off 内存），生产对账推荐（Phase 5 / Runbook §9）
# TRAVELTRUST_STRICT_EVIDENCE_DB_WRITE=0
# 订单聊天双写：=1 时 DB 插入失败返回 503（不写内存）
# TRAVELTRUST_STRICT_MESSAGE_DB_WRITE=0
# 评价双写：=1 时 DB 插入失败返回 503（不写内存）；迁移 ux_reviews_order_id_reviewer_id 须已应用
# TRAVELTRUST_STRICT_REVIEW_DB_WRITE=0
# 链下发起争议：=1 时 disputes 表 insert 失败则回滚订单状态与内存争议并返回 503（订单行会尽力写回前一状态）
# TRAVELTRUST_STRICT_DISPUTE_OPEN_DB_WRITE=0
# 仲裁裁决落库：=1 时订单 upsert 或 update_dispute_resolved 失败则回滚内存并尽力把订单行写回裁决前状态 → 503
# TRAVELTRUST_STRICT_DISPUTE_RESOLVE_DB_WRITE=0
# 行程双写（确认最终版 snapshot_hash、PATCH 写回 days/version）：=1 时 DB 更新失败回滚内存并 503
# TRAVELTRUST_STRICT_ITINERARY_DB_WRITE=0
# 订单行 upsert：=1 时 accept/cancel/mock pay/完成/双边确认/评分确认/开争议前 persist 等失败回滚内存并 503
# TRAVELTRUST_STRICT_ORDER_DB_WRITE=0
# B-409：主状态 Applied 时 stderr 输出 order_state_transition 行；=0 关闭（默认开启；索引器高频回放可临时关）
# TRAVELTRUST_ORDER_STATE_TRANSITION_STDERR=
# B-412：=1 时 Applied 后追加 order_state_transition_json 行（机读事实）
# TRAVELTRUST_ORDER_STATE_TRANSITION_JSON=0
# B-413：=1 时 EscrowChainEvent 软跳过打 order_state_transition_skipped（默认关）
# TRAVELTRUST_ORDER_STATE_TRANSITION_SKIPPED_STDERR=0
# B-412：Applied/Skipped 主状态域事实落库 order_state_transition_facts（需 DATABASE_URL）；=0 关闭写入
# TRAVELTRUST_ORDER_STATE_FACT_DB=
# 注册/登录会话落库：=1 时 insert_user/insert_session 失败回滚内存并 503
# TRAVELTRUST_STRICT_AUTH_DB_WRITE=0
# SEED_TEST_ACCOUNTS 测试账号：=1 时须先 DB 成功再写入内存；失败则跳过该账号（见 GET /meta seed_test_accounts）
# TRAVELTRUST_STRICT_SEED_DB_WRITE=0
# 向导注册 insert_guide：=1 时失败从内存移除并 503 guide_db_persist_failed
# TRAVELTRUST_STRICT_GUIDE_DB_WRITE=0
# 50-O-R1 / Runbook §9：运维声明的链下 DB 双写失败处置档位（观测用；与 GET /meta.dual_write、startup_snapshot 同源）
# 合法值（大小写不敏感）：log_only 或 1（① 默认）；strict_503 / fail_closed 或 2（② 须配合上列各 TRAVELTRUST_STRICT_*_DB_WRITE=1 分路径 503）；alert_only 或 3（③ 外接告警、HTTP 不变）。非法或空 → log_only。
# DUAL_WRITE_FAILURE_POLICY=log_only
# EVIDENCE_MAX_REQUESTS_PER_MINUTE=60
# 评价防刷（Phase 5 / 07）：每 (order_id, reviewer) 每分钟提交上限；0=不启用（默认）
# REVIEW_MAX_REQUESTS_PER_MINUTE=0
# 低分（≤2）评论最短字符；0=不校验
# REVIEW_LOW_SCORE_COMMENT_MIN_CHARS=20

# --------- 证据时间戳策略与链下回执（startup、routes/evidence；04 §三、缺口表 P1 证据 API） ---------
# 策略：backend_signed（默认）等；与代码 state::EvidenceTimeState 一致，详见 startup 日志 startup_snapshot 行。
# EVIDENCE_TIMESTAMP_POLICY=backend_signed
# 无 chain_off 时 POST 证据可走 backend_signed + HMAC 回执；生产须设强随机密钥（勿提交版本库）。
# EVIDENCE_RECEIPT_HMAC_KEY=
# 单调时钟/上次提交时间状态文件路径（默认 data/evidence_time_state.json）。
# EVIDENCE_TIME_STATE_PATH=data/evidence_time_state.json

# --------- Admin 对账导出 Ed25519（可选；200 / GET /meta.admin_exports） ---------
# 32 字节种子 hex（64 字符）。设置后 GET …/admin/indexer/reconcile-reports/export 对响应体字节签名，头 x-traveltrust-reconcile-export-ed25519；公钥见 GET /meta。
# RECONCILE_EXPORT_ED25519_SEED_HEX=

# --------- Indexer tick 可选自动 reorg（110 Partial；须 DATABASE_URL） ---------
# 设为 1 时：单轮 indexer-tick 在检测到 reorg_suspected 后至多自动执行一次与 indexer-reorg-rewind 同源的删尾+replay，成功响应可含 reorg_auto_rewind；仍不一致则 503 reorg_still_suspected_after_auto_rewind。不替代 Runbook 与 orders/chain_off 内存人工核对。
# INDEXER_REORG_AUTO_REWIND_ON_TICK=0

# tick 内补充 eth_getLogs（已关联 escrow 实例列表 / FEE_ROUTER_ADDRESS / REGION_VAULT_ADDRESS）：默认 RPC 失败仍 200，响应体含 logs_fetch_skipped（scope + error 等）。设为 1 时任一分支失败则整 tick 500 fetch_supplemental_logs_failed。
# INDEXER_STRICT_SUPPLEMENTAL_LOG_FETCH=0

# event_log 分轨强校验（91）：未设或非 0/false/off 即开启；写入 track_type（A/B/Escrow/Staking/Vault），同一 chain_id+tx_hash 不得跨轨混记。设为 0|false|off 时跳过分类与校验并写入 legacy_backfill（迁移/排障）。
# INDEXER_EVENT_LOG_TRACK_ENFORCE=1

# reorg-rewind / tick 自动回滚成功后：默认将 chain_off 内存 orders + guide_slot 与 orders 表对齐（list_orders）；仅内存且未落库订单保留。设为 0 跳过（大库/排障）；不设或非 0 即启用。
# INDEXER_REORG_RELOAD_CHAIN_OFF_ORDERS_AFTER_REWIND=0

# replay 后可选：将 orders 与重建后的 orders_projection 对齐（候选 = 已填 escrow 的订单 ∪ 本链投影中出现的 order_id）。无投影且已填 escrow：status=escrowed → accepted 并清 escrow（demoted_escrowed_no_projection）；status 为 draft/created/accepted → 清 escrow 列、保持状态（cleared_orphan_escrow_pre_funded）；completed/disputed/refunded/partially_refunded/slashed/cancelled 等终态 → 默认仅计入 skipped_no_projection_non_escrowed_with_escrow；另设下面为 1 时与 pre_funded 同路径清 escrow 列、保持 status（cleared_orphan_escrow_terminal_no_projection）。响应 orders_table_projection_sync 含上列计数等（110 §3.1.3 Partial，默认关）。
# INDEXER_REORG_SYNC_ORDERS_FROM_PROJECTION_AFTER_REWIND=1
# 须与上一行同时为 1 方生效：终态无投影时也自动清孤立 escrow_address（运维确认后启用）。
# INDEXER_REORG_SYNC_CLEAR_ORPHAN_ESCROW_TERMINAL=0

# --------- 链级 orders 删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 双闸） ---------
# 设为 1（trim）且 POST …/internal/indexer-reconcile 的 JSON 同时含 orders_chain_scope_rollback_execute:true 与 orders_chain_scope_rollback_confirm:"CONFIRM_DELETE_ORDERS_CHAIN_<chain_id>"（与 body chain_id 或 CHAIN_ID 默认一致）时，对账 200 后事务删除该链的 orders（仅 chain_id 匹配）与 orders_projection 及 evidence_receipts/disputes/reviews 等阻塞 FK 行；不设或非 1 时 **403** orders_chain_scope_rollback_execute_forbidden。**不**删 chain_id IS NULL 或其它链订单；**不**删 event_log。生产须 01/03 评审。
# TRAVELTRUST_ALLOW_ORDERS_CHAIN_SCOPE_ROLLBACK=0

# --------- 链级 event_log / checkpoint / FeeRouter 投影删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 独立双闸） ---------
# 设为 1 且 JSON 含 event_log_chain_scope_rollback_execute:true 与 event_log_chain_scope_rollback_confirm:"CONFIRM_DELETE_EVENT_LOG_CHAIN_<chain_id>" 时，对账 200 后事务删该链 event_log、checkpoints_sharded、fee_router_routed_events；不设或非 1 时 **403** event_log_chain_scope_rollback_execute_forbidden。**不**改进程内 indexer 内存进度（须重启或自行对齐 tick/replay）。与上一段 orders 回滚 ENV 独立。
# TRAVELTRUST_ALLOW_EVENT_LOG_CHAIN_SCOPE_ROLLBACK=0

# --------- 链级 correction_log / executor_executions 删除（110 §3.1.4 Partial；须 internal indexer-reconcile + 独立双闸） ---------
# 设为 1 且 JSON 含 correction_executor_chain_scope_rollback_execute:true 与 correction_executor_chain_scope_rollback_confirm:"CONFIRM_DELETE_CORRECTION_EXECUTOR_CHAIN_<chain_id>" 时，对账 200 后事务删该链两表行；不设或非 1 时 **403** correction_executor_chain_scope_rollback_execute_forbidden。与 orders/event_log 回滚 ENV 独立。
# TRAVELTRUST_ALLOW_CORRECTION_EXECUTOR_CHAIN_SCOPE_ROLLBACK=0

# --------- 进程内 indexer 与 DB checkpoint 对齐（110 §3.1.4 Partial） ---------
# 设为 1 且 POST …/internal/indexer-reconcile JSON 含 sync_indexer_memory_from_db_checkpoint:true 时，对账 200 后按 checkpoints_sharded（traveltrust_indexer_tick_v1）重写进程内 last_block/last_log_index、裁剪内存 events、落盘 INDEXER_STATE_PATH.runtime；无 DB 行时等价归零。**403** indexer_memory_sync_from_db_forbidden。GET /meta.indexer.memory 即读进程内态；GET /meta.indexer.checkpoint 仍可能为启动快照直至重启。
# TRAVELTRUST_ALLOW_INDEXER_MEMORY_SYNC_FROM_DB=0

# --------- revenue pipeline B-390 freshness→suspect（traveltrust-api；见 04 §3.4 / TT-B390） ---------
# **B-389** **`age_seconds`** 大于该阈值时 **`freshness_abnormal_reason=stale`**，并对**本次请求** **B-386** **bundle** 中 **`marker`** 为 **`drift`** / **`incomparable`** 的腿与 **`rollup`** 输出 **`suspect_due_to_freshness:true`**。正整数秒；非法或缺省 → **86400**。
# TRAVELTRUST_REVENUE_PIPELINE_FRESHNESS_STALE_SUSPECT_SECS=86400

# --------- Outbox / 执行器（48、Runbook；CHAIN_* 已设时启用 worker） ---------
# 待发送链上事件目录；/meta 与 intents 等读取。
# OUTBOX_DIR=data/outbox
# 设为 1 时启动后台 outbox worker（见 startup）。
# OUTBOX_WORKER=0
# OUTBOX_LEASE_SECS=60
# OUTBOX_POLL_MS=500
# OUTBOX_MAX_ATTEMPTS=10

# --------- 关键写接口限流（55 G7、53 附录 A BB5、Runbook §1） ---------
# accept、confirm-bilateral、confirm-rating、confirm-final-plan、cancel、reviews 按 IP 每分钟上限；0 表示不限制。默认 15。
# CRITICAL_WRITE_RATE_LIMIT_PER_MINUTE=15

# --------- 前端构建用（frontend/ Next.js） ---------
# API 基地址，构建时注入（见 05 §四；frontend 使用 NEXT_PUBLIC_API_BASE_URL）；须等于上列 **PORT** 对应的 loopback URL（全栈推荐 8080，与 Next 3012 并存）
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# TT 社区 showcase（同一变量、两档语义，见 `frontend/lib/communityShowcase.ts`）：
# - **内容流**（Feed/探索空帖）：dev 默认开；**生产**关闭；`=0` 关、`=1` 强开。关注 Tab（`mode=follow`）永不注入帖。
# - **关系链 UI**（好友列表、私信列表、`tt-showcase-conv-*` 只读会话）：**仅 `=1` 时**注入演示数据，与测试网/公网「空即空」默认一致。
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_SHOWCASE=0
# NEXT_PUBLIC_TRAVELTRUST_COMMUNITY_SHOWCASE=1
# ② 测试网构建：关闭社区 showcase 注入（与 `communityShowcase.ts` 同源）
# NEXT_PUBLIC_TRAVELTRUST_PHASE=2
# NEXT_PUBLIC_TRAVELTRUST_DEPLOY_PROFILE=testnet
# Experience 草稿 `/escrow/*`：`=1` 时显示「高级·链上与订单操作」调试区（旅行者默认隐藏；本地联调链上再开）
# NEXT_PUBLIC_ESCROW_DEV_TOOLS=1
# 与 CHAIN_ID / wagmi 目标链一致（默认 137）；自定义链时配合 NEXT_PUBLIC_RPC_URL
# NEXT_PUBLIC_CHAIN_ID=137
# NEXT_PUBLIC_RPC_URL=
# 部署的 Registry 合约（方案 B）；未设时质押页不展示链上资格只读块
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x...
# 部署的 Guide 池（与后端 GUIDE_STAKING_ADDRESS、GET /meta.chain.contracts.guide_staking_address 一致）
# NEXT_PUBLIC_GUIDE_STAKING_ADDRESS=0x...
# Provider 池（与后端 STAKING_PROVIDER_ADDRESS、GET /meta.chain.contracts.staking_provider_address 一致）；未设时 Provider 质押 UI 可隐藏
# NEXT_PUBLIC_STAKING_PROVIDER_ADDRESS=0x...
# WalletConnect v2（可选）
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

